<%- include('../partials/header', { 
    title: alumno.nombre_completo, 
    active: 'alumnos',
    breadcrumb: `<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/alumnos">Alumnos</a></li><li class="breadcrumb-item active">${alumno.nombre_completo}</li></ol></nav>`
}) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="mb-1"><%= alumno.nombre_completo %></h4>
        <span class="badge bg-secondary"><%= alumno.curso ? alumno.curso.nombre : 'Sin curso' %></span>
        <span class="text-muted ms-2"><%= alumno.rut %></span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e8f0fe;color:#1967d2;"><i class="bi bi-clipboard-check"></i></div>
            <div>
                <div class="stat-number"><%= total_evals %></div>
                <div class="stat-label">Evaluaciones del curso</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fce8e6;color:#c5221f;"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="stat-number"><%= total_ausencias %></div>
                <div class="stat-label">Inasistencias</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef7e0;color:#b05a00;"><i class="bi bi-arrow-counterclockwise"></i></div>
            <div>
                <div class="stat-number"><%= recuperaciones.filter(r => r.estado === 'pendiente').length %></div>
                <div class="stat-label">Recuperaciones pendientes</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e6f4ea;color:#137333;"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-number"><%= recuperaciones.filter(r => r.estado === 'completada').length %></div>
                <div class="stat-label">Recuperaciones completadas</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Historial de asistencias -->
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Historial de Asistencias a Evaluaciones</h6>
            </div>
            <div class="card-body p-0">
                <% if (asistencias.length > 0) { %>
                <!-- Vista tabla para Desktop y Tablets -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="nowrap">Fecha</th>
                                <th style="min-width: 140px;">Evaluación</th>
                                <th class="nowrap">Asignatura</th>
                                <th class="nowrap">Estado</th>
                                <th>Motivo</th>
                                <th class="nowrap">Justificado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% asistencias.forEach(item => { %>
                            <tr>
                                <td class="nowrap"><%= item.evaluacion.fecha %></td>
                                <td>
                                    <a href="/evaluaciones/<%= item.evaluacion.id %>" class="text-decoration-none fw-semibold"><%= item.evaluacion.titulo %></a>
                                </td>
                                <td class="nowrap"><span class="badge" style="background:<%= item.evaluacion.asignatura.color %>;"><%= item.evaluacion.asignatura.nombre %></span></td>
                                <td>
                                    <% if (item.asistencia.presente) { %>
                                    <span class="badge bg-success">Presente</span>
                                    <% } else { %>
                                    <span class="badge bg-danger">Ausente</span>
                                    <% } %>
                                </td>
                                <td class="text-muted small"><%= item.asistencia.motivo || '-' %></td>
                                <td>
                                    <% if (!item.asistencia.presente) { %>
                                        <% if (item.asistencia.justificado) { %>
                                        <span class="badge bg-success">Sí (60%)</span>
                                        <% } else { %>
                                        <span class="badge bg-secondary">No (70%)</span>
                                        <% if (current_user && current_user.rol === 'inspe') { %>
                                        <a href="/evaluaciones/<%= item.evaluacion.id %>" class="btn btn-outline-warning btn-sm py-0 px-1 ms-1" style="font-size:0.7rem;" title="Justificar en Inspectoría">
                                            <i class="bi bi-file-earmark-medical me-1"></i>Justificar
                                        </a>
                                        <% } %>
                                        <% } %>
                                    <% } else { %>
                                    <span class="text-muted small">-</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Tarjetas para móvil (< 768px) -->
                <div class="d-md-none p-3">
                    <div class="row g-2">
                        <% asistencias.forEach(item => { %>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded border">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <span class="badge" style="background:<%= item.evaluacion.asignatura.color %>;"><%= item.evaluacion.asignatura.nombre %></span>
                                    <span class="small text-muted"><i class="bi bi-calendar-event me-1"></i><%= item.evaluacion.fecha %></span>
                                </div>
                                <h6 class="mb-1">
                                    <a href="/evaluaciones/<%= item.evaluacion.id %>" class="text-decoration-none text-dark fw-bold">
                                        <%= item.evaluacion.titulo %>
                                    </a>
                                </h6>
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top">
                                    <div>
                                        <% if (item.asistencia.presente) { %>
                                        <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Presente</span>
                                        <% } else { %>
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Ausente</span>
                                        <% } %>
                                    </div>
                                    <% if (!item.asistencia.presente) { %>
                                        <div>
                                            <% if (item.asistencia.justificado) { %>
                                            <span class="badge bg-success">Justificado (60%)</span>
                                            <% } else { %>
                                            <span class="badge bg-danger">Injustificado (70%)</span>
                                            <% } %>
                                        </div>
                                    <% } %>
                                    <% if (item.asistencia.motivo) { %>
                                        <div class="small text-muted w-100 mt-1 fst-italic">
                                            <%= item.asistencia.motivo %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } else { %>
                <p class="text-center text-muted py-4">No hay registros de asistencia para este alumno.</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Recuperaciones del alumno -->
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i>Recuperaciones</h6>
                <% if (['profe'].includes(current_user.rol)) { %>
                <a href="/recuperaciones/crear?alumno_id=<%= alumno.id %>" class="btn btn-sm btn-outline-primary">Asignar</a>
                <% } %>
            </div>
            <div class="card-body">
                <% if (recuperaciones.length > 0) { %>
                <div class="list-group list-group-flush">
                    <% recuperaciones.forEach(rec => { %>
                    <div class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="small"><%= rec.evaluacion ? rec.evaluacion.titulo : 'Evaluación' %></strong>
                                <br><small class="text-muted">Fecha: <%= rec.fecha_recuperacion %></small>
                                <br>
                                <% if (Number(rec.porcentaje_exigencia) >= 70) { %>
                                <span class="badge bg-danger" title="Sin justificar">Exigencia <%= Math.round(rec.porcentaje_exigencia) %>%</span>
                                <% } else { %>
                                <span class="badge bg-success" title="Justificada">Exigencia <%= Math.round(rec.porcentaje_exigencia) %>%</span>
                                <% } %>
                            </div>
                            <% if (rec.estado === 'pendiente') { %>
                            <span class="badge bg-warning text-dark">Pendiente</span>
                            <% } else if (rec.estado === 'completada') { %>
                            <span class="badge bg-success">Completada</span>
                            <% } else { %>
                            <span class="badge bg-secondary">Cancelada</span>
                            <% } %>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <p class="text-center text-muted py-4">Sin recuperaciones registradas.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
