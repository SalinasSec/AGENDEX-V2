<%- include('../partials/header', { 
    title: 'Calendario de Evaluaciones', 
    active: 'calendario',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item active">Calendario</li></ol></nav>'
}) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="mb-0"><i class="bi bi-calendar3 me-2 text-primary"></i>Calendario Escolar</h4>
        <small class="text-muted">Vista mensual de evaluaciones calendarizadas y recuperaciones programadas</small>
    </div>
    
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
            <i class="bi bi-clipboard-check me-1"></i><strong><%= total_evals_mes %></strong> Evaluaciones
        </span>
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
            <i class="bi bi-arrow-counterclockwise me-1"></i><strong><%= total_recups_mes %></strong> Recuperaciones
        </span>

        <% 
            const prevMes = mes > 1 ? mes - 1 : 12;
            const prevAnio = mes > 1 ? anio : anio - 1;
            const nextMes = mes < 12 ? mes + 1 : 1;
            const nextAnio = mes < 12 ? anio + 1 : anio;
        %>
        <div class="btn-group ms-sm-2" role="group">
            <a href="/reportes/calendario?mes=<%= prevMes %>&anio=<%= prevAnio %><%= filtros.curso_id ? '&curso_id=' + filtros.curso_id : '' %>" class="btn btn-sm btn-outline-secondary" title="Mes Anterior">
                <i class="bi bi-chevron-left"></i>
            </a>
            <span class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark">
                <%= mes_nombre %> <%= anio %>
            </span>
            <a href="/reportes/calendario?mes=<%= nextMes %>&anio=<%= nextAnio %><%= filtros.curso_id ? '&curso_id=' + filtros.curso_id : '' %>" class="btn btn-sm btn-outline-secondary" title="Mes Siguiente">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <a href="/reportes/calendario" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar-event me-1"></i>Hoy</a>
    </div>
</div>

<!-- Filtros de Navegación Rápida -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <form method="GET" action="/reportes/calendario" class="row g-2 align-items-end">
            <div class="col-6 col-sm-auto">
                <label class="form-label small mb-1 fw-semibold">Mes</label>
                <select name="mes" class="form-select form-select-sm">
                    <% meses.forEach(m => { %>
                    <option value="<%= m.num %>" <%= m.num === mes ? 'selected' : '' %>><%= m.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-6 col-sm-auto">
                <label class="form-label small mb-1 fw-semibold">Año</label>
                <input type="number" name="anio" class="form-control form-control-sm" value="<%= anio %>" style="max-width:95px;">
            </div>

            <% if (current_user.rol !== 'alumno') { %>
            <div class="col-12 col-sm-auto">
                <label class="form-label small mb-1 fw-semibold">Filtrar por Curso</label>
                <select name="curso_id" class="form-select form-select-sm">
                    <option value="">Todos los cursos</option>
                    <% if (typeof mis_cursos_ids !== 'undefined' && mis_cursos_ids && mis_cursos_ids.length > 0) { %>
                    <optgroup label="Mis Cursos Asignados">
                        <% cursos.filter(c => mis_cursos_ids.includes(c.id)).forEach(c => { %>
                        <option value="<%= c.id %>" <%= filtros.curso_id == c.id ? 'selected' : '' %>>★ <%= c.nombre %> (<%= c.nivel %>)</option>
                        <% }) %>
                    </optgroup>
                    <optgroup label="Otros Cursos">
                        <% cursos.filter(c => !mis_cursos_ids.includes(c.id)).forEach(c => { %>
                        <option value="<%= c.id %>" <%= filtros.curso_id == c.id ? 'selected' : '' %>><%= c.nombre %> (<%= c.nivel %>)</option>
                        <% }) %>
                    </optgroup>
                    <% } else { %>
                        <% cursos.forEach(c => { %>
                        <option value="<%= c.id %>" <%= filtros.curso_id == c.id ? 'selected' : '' %>><%= c.nombre %> (<%= c.nivel %>)</option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div class="col-12 col-sm-auto">
                <label class="form-label small mb-1 fw-semibold">Filtrar por Docente</label>
                <select name="profesor_id" class="form-select form-select-sm">
                    <option value="">Todos los profesores</option>
                    <% if (typeof profesores !== 'undefined' && profesores) { %>
                        <% profesores.forEach(p => { %>
                        <option value="<%= p.id %>" <%= filtros.profesor_id == p.id ? 'selected' : '' %>>
                            <%= p.nombre %> <%= (typeof current_prof_id !== 'undefined' && current_prof_id === p.id) ? '(Tú)' : '' %>
                        </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <% if (typeof es_profe !== 'undefined' && es_profe) { %>
            <div class="col-12 col-sm-auto pb-1">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" name="mis_pruebas" value="1" id="chkMisPruebas" <%= filtros.solo_mis_pruebas ? 'checked' : '' %>>
                    <label class="form-check-label small fw-semibold text-secondary" for="chkMisPruebas">
                        Ver sólo mis pruebas
                    </label>
                </div>
            </div>
            <% } %>

            <% } else { %>
            <div class="col-12 col-sm-auto">
                <span class="badge bg-info-subtle text-info border border-info-subtle py-2 px-3">
                    <i class="bi bi-mortarboard me-1"></i>Viendo tu calendario escolar
                </span>
            </div>
            <% } %>

            <div class="col-12 col-sm-auto">
                <button type="submit" class="btn btn-primary btn-sm w-100 w-sm-auto px-3">
                    <i class="bi bi-funnel me-1"></i> Aplicar Filtro
                </button>
            </div>
            <% if (filtros.curso_id || filtros.profesor_id || filtros.solo_mis_pruebas) { %>
            <div class="col-12 col-sm-auto">
                <a href="/reportes/calendario?mes=<%= mes %>&anio=<%= anio %>" class="btn btn-sm btn-outline-secondary w-100 w-sm-auto">
                    <i class="bi bi-x-circle me-1"></i> Limpiar filtros
                </a>
            </div>
            <% } %>
        </form>
    </div>
</div>

<!-- Vista Calendario Grid -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-2 p-md-3">
        <div class="d-block d-md-none text-muted small mb-2 text-center">
            <i class="bi bi-arrow-left-right me-1 text-primary"></i>Desliza horizontalmente para ver la semana completa
        </div>

        <div class="table-responsive">
            <table class="table table-bordered mb-0" style="min-width: 780px;">
                <thead>
                    <tr class="table-light text-center">
                        <th style="width: 14.28%;">Lunes</th>
                        <th style="width: 14.28%;">Martes</th>
                        <th style="width: 14.28%;">Miércoles</th>
                        <th style="width: 14.28%;">Jueves</th>
                        <th style="width: 14.28%;">Viernes</th>
                        <th style="width: 14.28%;" class="text-muted">Sábado</th>
                        <th style="width: 14.28%;" class="text-muted">Domingo</th>
                    </tr>
                </thead>
                <tbody>
                    <% semanas.forEach(semana => { %>
                    <tr>
                        <% semana.forEach((dia, indexDia) => { %>
                            <% if (dia === 0) { %>
                            <td class="bg-light-subtle" style="height: 125px; min-width: 110px;"></td>
                            <% } else { %>
                            <% const esHoy = (dia === today_day && anio === today_year && mes === today_month); %>
                            <% const esFinde = (indexDia >= 5); %>
                            <td class="align-top position-relative <%= esHoy ? 'bg-primary-subtle border-primary' : (esFinde ? 'bg-light' : '') %>" 
                                style="height: 125px; min-width: 110px;">
                                
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge <%= esHoy ? 'bg-primary text-white rounded-pill px-2' : (esFinde ? 'text-muted' : 'text-dark fw-bold') %>">
                                        <%= dia %>
                                    </span>
                                    <% if (esHoy) { %>
                                    <span class="badge bg-primary text-white text-uppercase" style="font-size: 0.6rem;">Hoy</span>
                                    <% } %>
                                </div>

                                <div class="d-flex flex-column gap-1">
                                    <!-- Si el curso está filtrado y el día tiene evaluaciones: Indicador de cupos copados -->
                                    <% if (evals_por_dia[dia] && evals_por_dia[dia].length >= 2 && filtros.curso_id) { %>
                                    <div class="badge bg-danger text-white w-100 text-truncate py-1 mb-1 shadow-xs" style="font-size: 0.65rem;" title="Tope máximo de 2 evaluaciones alcanzado en este curso">
                                        <i class="bi bi-lock-fill me-1"></i>2/2 Cupos (Copado)
                                    </div>
                                    <% } else if (evals_por_dia[dia] && evals_por_dia[dia].length === 1 && filtros.curso_id) { %>
                                    <div class="badge bg-info-subtle text-info-emphasis border border-info-subtle w-100 text-truncate py-0 mb-1" style="font-size: 0.62rem;" title="1 evaluación programada, queda 1 cupo disponible">
                                        <i class="bi bi-unlock-fill me-1"></i>1 cupo disponible (1/2)
                                    </div>
                                    <% } %>

                                    <!-- Evaluaciones Regulares -->
                                    <% if (evals_por_dia[dia] && evals_por_dia[dia].length > 0) { %>
                                        <% evals_por_dia[dia].forEach(ev => { %>
                                        <a href="/evaluaciones/<%= ev.id %>" 
                                           class="text-start text-decoration-none text-white small p-1 rounded shadow-xs d-block <%= ev.es_mia ? 'border border-2 border-warning' : '' %>" 
                                           style="background:<%= (ev.asignatura && ev.asignatura.color) ? ev.asignatura.color : '#0d6efd' %>; transition: transform 0.15s ease;"
                                           title="<%= ev.titulo %> — <%= ev.curso ? ev.curso.nombre : '' %> (<%= ev.profesor ? ev.profesor.nombre_completo : 'Docente' %> - <%= ev.hora || '' %>)">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="fw-semibold text-truncate" style="font-size: 0.78rem;">
                                                    <i class="bi bi-pencil-square me-1"></i><%= ev.titulo %>
                                                </div>
                                                <% if (ev.es_mia) { %>
                                                <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.60rem;">Tú</span>
                                                <% } %>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center opacity-90" style="font-size: 0.68rem;">
                                                <span class="text-truncate"><%= ev.curso ? ev.curso.nombre : '' %></span>
                                                <span><%= ev.hora || '' %></span>
                                            </div>
                                            <div class="opacity-90 text-truncate" style="font-size: 0.67rem; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 1px; margin-top: 1px;">
                                                <i class="bi bi-person me-1"></i><%= ev.profesor ? ev.profesor.nombre_completo : 'Docente' %>
                                            </div>
                                        </a>
                                        <% }) %>
                                    <% } %>

                                    <!-- Recuperaciones Programadas -->
                                    <% if (recups_por_dia[dia] && recups_por_dia[dia].length > 0) { %>
                                        <% recups_por_dia[dia].forEach(r => { %>
                                        <% 
                                            const esSalida = (r.tipo_justificacion === 'salida_pedagogica') || (r.motivo && r.motivo.toLowerCase().includes('salida'));
                                            const exig70 = Number(r.porcentaje_exigencia) >= 70;
                                        %>
                                        <a href="/recuperaciones" 
                                           class="text-start text-decoration-none small p-1 rounded border shadow-xs d-block <%= exig70 ? 'bg-danger-subtle border-danger text-danger-emphasis' : (esSalida ? 'bg-info-subtle border-info text-info-emphasis' : 'bg-warning-subtle border-warning text-warning-emphasis') %>"
                                           title="Recuperación: <%= r.alumno ? (r.alumno.nombre_completo || r.alumno.nombre) : 'Alumno' %> &bull; Exigencia: <%= Math.round(r.porcentaje_exigencia) %>%">
                                            <div class="fw-bold text-truncate" style="font-size: 0.74rem;">
                                                <i class="bi bi-arrow-counterclockwise"></i> Recup: <%= r.alumno ? (r.alumno.nombre_completo || r.alumno.nombre) : 'Alumno' %>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center" style="font-size: 0.66rem;">
                                                <span class="text-truncate"><%= r.evaluacion ? r.evaluacion.titulo : 'Prueba' %></span>
                                                <span class="badge <%= exig70 ? 'bg-danger' : (esSalida ? 'bg-info text-dark' : 'bg-success') %>">
                                                    <%= Math.round(r.porcentaje_exigencia) %>%
                                                </span>
                                            </div>
                                        </a>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </td>
                            <% } %>
                        <% }) %>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Leyenda Informativa -->
<div class="card shadow-sm border-0">
    <div class="card-body py-3">
        <h6 class="card-title fw-bold small text-muted text-uppercase mb-2">Leyenda del Calendario</h6>
        <div class="d-flex flex-wrap gap-3 align-items-center small">
            <div class="d-flex align-items-center gap-1">
                <span class="badge bg-primary">&nbsp;&nbsp;</span>
                <span>Evaluación regular de curso</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <span class="badge bg-success">60%</span>
                <span>Recuperación con Certificado Médico (60% regular)</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <span class="badge bg-info text-dark">60%</span>
                <span>Recuperación por Salida Pedagógica oficial (60% regular)</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <span class="badge bg-danger">70%</span>
                <span>Recuperación Injustificada (70% escala reglamentaria)</span>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
