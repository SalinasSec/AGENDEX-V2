<%- include('../partials/header', { 
    title: 'Carga Académica', 
    active: 'carga',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/reportes/calendario">Reportes</a></li><li class="breadcrumb-item active">Carga Académica</li></ol></nav>'
}) %>

<% 
    const prevMes = mes > 1 ? mes - 1 : 12;
    const prevAnio = mes > 1 ? anio : anio - 1;
    const nextMes = mes < 12 ? mes + 1 : 1;
    const nextAnio = mes < 12 ? anio + 1 : anio;
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="mb-0"><i class="bi bi-bar-chart-line me-2 text-success"></i>Carga Académica por Curso</h4>
        <small class="text-muted">Monitoreo de evaluaciones acumuladas y disponibilidad de cupos diarios por curso</small>
    </div>

    <!-- Navegación de Mes y Año -->
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group" role="group">
            <a href="/reportes/carga?mes=<%= prevMes %>&anio=<%= prevAnio %><%= solo_mis_cursos ? '&mis_cursos=1' : '' %>" class="btn btn-sm btn-outline-secondary" title="Mes Anterior">
                <i class="bi bi-chevron-left"></i>
            </a>
            <span class="btn btn-sm btn-light border px-3 fw-bold disabled text-dark">
                <%= mes_nombre %> <%= anio %>
            </span>
            <a href="/reportes/carga?mes=<%= nextMes %>&anio=<%= nextAnio %><%= solo_mis_cursos ? '&mis_cursos=1' : '' %>" class="btn btn-sm btn-outline-secondary" title="Mes Siguiente">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <a href="/reportes/carga" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar-event me-1"></i>Mes Actual</a>
    </div>
</div>

<!-- Filtros Rápidos -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-2 px-3">
        <form method="GET" action="/reportes/carga" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold text-muted">Mes:</label>
            </div>
            <div class="col-auto">
                <select name="mes" class="form-select form-select-sm" onchange="this.form.submit()">
                    <% meses.forEach(m => { %>
                    <option value="<%= m.num %>" <%= m.num === mes ? 'selected' : '' %>><%= m.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold text-muted">Año:</label>
            </div>
            <div class="col-auto">
                <input type="number" name="anio" class="form-control form-control-sm" value="<%= anio %>" style="width: 95px;" onchange="this.form.submit()">
            </div>
            <% if (current_user && current_user.rol === 'profe' && prof_obj) { %>
            <div class="col-auto ms-auto">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchMisCursos" name="mis_cursos" value="1" <%= solo_mis_cursos ? 'checked' : '' %> onchange="this.form.submit()">
                    <label class="form-check-label small fw-semibold" for="switchMisCursos">
                        Filtrar sólo mis cursos asignados
                    </label>
                </div>
            </div>
            <% } %>
        </form>
    </div>
</div>

<!-- KPIs del Mes -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
                        <i class="bi bi-clipboard-check fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark"><%= total_evals %></div>
                        <div class="small text-muted">Evaluaciones en <%= mes_nombre %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 me-3">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-danger"><%= cursos_alta_carga %></div>
                        <div class="small text-muted">Cursos con Alta Carga</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning-emphasis p-3 me-3">
                        <i class="bi bi-calendar-x-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-warning-emphasis"><%= total_dias_saturados %></div>
                        <div class="small text-muted">Días al Tope Diario (2/2)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 me-3">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-success"><%= cursos_normal_carga %></div>
                        <div class="small text-muted">Cursos Carga Equilibrada</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Aclaración Didáctica: Regla Liceo vs Carga Académica -->
<div class="card border-info-subtle bg-info bg-opacity-10 shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-info-circle-fill text-info fs-3 mt-1"></i>
            <div>
                <h6 class="fw-bold mb-1 text-dark">
                    ¿Cómo funciona el límite de 2 evaluaciones y cuándo se considera "Alta Carga"?
                </h6>
                <div class="small text-secondary" style="line-height: 1.5;">
                    <div class="mb-1">
                        <strong>1. Límite Diario Estricto (Regla de Oro del Liceo):</strong> En un <strong>mismo día calendario</strong>, ningún curso puede tener más de <strong>2 evaluaciones</strong>. Si un día ya tiene 2 pruebas, el sistema <strong>bloquea automáticamente la creación de una 3ª</strong> para proteger la salud mental y el rendimiento de los estudiantes.
                    </div>
                    <div>
                        <strong>2. ¿Por qué un curso puede llegar a "Alta Carga" si el sistema no deja poner más de 2 en un día?</strong>
                        <ul class="mb-0 ps-3 mt-1">
                            <li><strong>Alta Carga Diaria:</strong> Ocurre cuando un día específico ya tiene <strong>2 de 2 pruebas agendadas</strong> (capacidad diaria agotada al 100%, 0 cupos disponibles para otros profesores en esa fecha).</li>
                            <li><strong>Alta Carga Mensual (Global de todas las asignaturas):</strong> Aunque ningún día individual supere las 2 pruebas, cuando los distintos profesores (Matemáticas, Lenguaje, Historia, Ciencias, Inglés, etc.) agendan sus pruebas en distintos días del mes y el curso acumula <strong>6 o más evaluaciones</strong> en total, el curso entra en <strong>Alta Carga Académica</strong>.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla y Desglose de Cursos -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-graph-up me-2 text-primary"></i>Distribución de Evaluaciones por Curso en <%= mes_nombre %> <%= anio %></h6>
        <span class="text-muted small"><%= datos_curso.length %> curso(s) analizado(s)</span>
    </div>
    <div class="card-body p-0">
        <% if (datos_curso.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th style="min-width: 160px;">Curso</th>
                        <th style="min-width: 260px;">Carga Mensual / Progresión</th>
                        <th style="min-width: 140px;" class="text-center">Estado de Carga</th>
                        <th style="min-width: 180px;">Disponibilidad Diaria</th>
                        <th style="min-width: 130px;" class="text-end">Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    <% datos_curso.forEach(d => { %>
                    <tr>
                        <td>
                            <div class="fw-bold text-dark"><%= d.curso.nombre %></div>
                            <span class="badge bg-light text-secondary border py-1">
                                <i class="bi bi-people me-1"></i><%= d.alumnos %> estudiantes
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 24px;">
                                    <% const pct = Math.round((d.evals_mes / max_evals) * 100); %>
                                    <div class="progress-bar <%= d.carga_nivel === 'alta' ? 'bg-danger' : (d.carga_nivel === 'media' ? 'bg-warning text-dark' : 'bg-success') %>" 
                                         style="width: <%= Math.max(pct, 10) %>%;">
                                        <span class="small fw-bold px-2"><%= d.evals_mes %> prueba(s)</span>
                                    </div>
                                </div>
                                <span class="small text-muted text-nowrap"><%= d.evals_mes %> total</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.76rem; margin-top: 2px;">
                                <i class="bi bi-info-circle me-1"></i><%= d.carga_razon %>
                            </div>
                        </td>
                        <td class="text-center">
                            <% if (d.carga_nivel === 'alta') { %>
                            <span class="badge bg-danger px-2 py-1">
                                <i class="bi bi-fire me-1"></i>Alta carga
                            </span>
                            <% } else if (d.carga_nivel === 'media') { %>
                            <span class="badge bg-warning text-dark px-2 py-1">
                                <i class="bi bi-dash-circle me-1"></i>Media
                            </span>
                            <% } else { %>
                            <span class="badge bg-success px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i>Normal
                            </span>
                            <% } %>
                        </td>
                        <td>
                            <% if (d.dias_saturados.length > 0) { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-block mb-1" title="Días donde ya no se pueden agendar más evaluaciones">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i><%= d.dias_saturados.length %> día(s) al tope (2/2)
                            </span>
                            <div class="small text-danger" style="font-size: 0.75rem;">
                                <%= d.dias_saturados.map(ds => ds.fecha.split('-').reverse().slice(0, 2).join('/')).join(', ') %> (Lleno)
                            </div>
                            <% } else if (d.dias_parciales.length > 0) { %>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle d-inline-block">
                                <i class="bi bi-check2 me-1"></i><%= d.dias_parciales.length %> día(s) con 1 cupo disponible
                            </span>
                            <% } else { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-calendar-check me-1"></i>Todos los días libres
                            </span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#detalleCurso<%= d.curso.id %>" aria-expanded="false">
                                <i class="bi bi-list-check me-1"></i>Ver pruebas (<%= d.evals_mes %>)
                            </button>
                        </td>
                    </tr>

                    <!-- Desglose de Evaluaciones del Curso (Acordeón / Collapse) -->
                    <tr class="collapse bg-light" id="detalleCurso<%= d.curso.id %>">
                        <td colspan="5" class="p-3">
                            <div class="card border">
                                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                                    <strong class="small text-uppercase"><i class="bi bi-calendar3 me-1 text-primary"></i>Evaluaciones calendarizadas para <%= d.curso.nombre %> en <%= mes_nombre %> <%= anio %></strong>
                                    <span class="badge bg-secondary"><%= d.evals_mes %> prueba(s) en total</span>
                                </div>
                                <div class="card-body p-0">
                                    <% if (d.evaluaciones.length > 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-0 align-middle">
                                            <thead class="table-light small">
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Cupo del Día</th>
                                                    <th>Asignatura</th>
                                                    <th>Título de Evaluación</th>
                                                    <th>Profesor a Cargo</th>
                                                    <th>Hora</th>
                                                    <th class="text-center">Acción</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% d.evaluaciones.forEach(ev => { %>
                                                <tr class="<%= ev.diaSaturado ? 'table-danger-subtle' : '' %>">
                                                    <td>
                                                        <strong><%= ev.fecha %></strong>
                                                    </td>
                                                    <td>
                                                        <% if (ev.diaSaturado) { %>
                                                        <span class="badge bg-danger">
                                                            <i class="bi bi-lock-fill me-1"></i>2/2 Cupos (Día Copado)
                                                        </span>
                                                        <% } else { %>
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-unlock-fill me-1"></i>1/2 Cupo (1 Disponible)
                                                        </span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <span class="badge" style="background-color: <%= ev.asignatura.color || '#14213D' %>;">
                                                            <%= ev.asignatura.nombre %>
                                                        </span>
                                                    </td>
                                                    <td class="fw-semibold"><%= ev.titulo %></td>
                                                    <td><%= ev.profesor.nombre_completo || 'Docente' %></td>
                                                    <td class="text-muted"><%= ev.hora || '-' %></td>
                                                    <td class="text-center">
                                                        <a href="/evaluaciones/<%= ev.id %>" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;">
                                                            <i class="bi bi-eye me-1"></i>Ver Detalle
                                                        </a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <% } else { %>
                                    <p class="text-muted text-center py-3 mb-0 small">
                                        <i class="bi bi-calendar-x me-1"></i>No hay evaluaciones agendadas para este curso en <%= mes_nombre %> <%= anio %>.
                                    </p>
                                    <% } %>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="text-center py-5 text-muted">
            <i class="bi bi-bar-chart display-1 text-secondary"></i>
            <p class="mt-3">No hay datos de cursos disponibles para este período.</p>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
