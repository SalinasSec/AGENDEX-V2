<%- include('../partials/header', { 
    title: 'Carga Académica', 
    active: 'carga',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/reportes/calendario">Reportes</a></li><li class="breadcrumb-item active">Carga Académica</li></ol></nav>'
}) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h4 class="mb-0"><i class="bi bi-bar-chart-line me-2 text-success"></i>Carga Académica por Curso</h4>
    <span class="text-muted">Mes: <%= mes_nombre %> <%= anio %></span>
</div>

<% 
    const all_evals = datos_curso.map(d => d.evals_mes);
    const max_evals = Math.max(...all_evals, 1);
    const total_evals = all_evals.reduce((a, b) => a + b, 0);
%>

<div class="row g-4">
    <!-- Gráfico de barras por curso -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Evaluaciones por Curso este Mes</h6>
            </div>
            <div class="card-body">
                <% if (datos_curso.length > 0) { %>
                <table class="table table-borderless mb-0 align-middle">
                    <tbody>
                        <% datos_curso.forEach(d => { %>
                        <tr>
                            <td style="width:140px;"><strong><%= d.curso.nombre %></strong></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1" style="height:28px;">
                                        <% const pct = Math.round((d.evals_mes / max_evals) * 100); %>
                                        <div class="progress-bar <%= d.evals_mes >= 8 ? 'bg-danger' : (d.evals_mes >= 5 ? 'bg-warning text-dark' : 'bg-success') %>" 
                                             style="width: <%= Math.max(pct, 8) %>%;">
                                            <%= d.evals_mes %> evals
                                        </div>
                                    </div>
                                    <span class="ms-2 small text-muted text-nowrap"><%= d.alumnos %> alumnos</span>
                                </div>
                            </td>
                            <td style="width:120px;" class="text-end">
                                <% if (d.evals_mes >= 8) { %>
                                <span class="badge bg-danger">Alta carga</span>
                                <% } else if (d.evals_mes >= 5) { %>
                                <span class="badge bg-warning text-dark">Media</span>
                                <% } else { %>
                                <span class="badge bg-success">Normal</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } else { %>
                <p class="text-muted text-center py-4">No hay datos disponibles para este período.</p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Resumen -->
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Resumen del Mes</h6>
            </div>
            <div class="card-body">
                <div class="row text-center g-3 mb-3">
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <div class="display-6 fw-bold text-primary"><%= total_evals %></div>
                            <div class="small text-muted">Evaluaciones totales</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <div class="display-6 fw-bold text-success"><%= datos_curso.length %></div>
                            <div class="small text-muted">Cursos activos</div>
                        </div>
                    </div>
                </div>
                <div class="alert alert-info small mb-0">
                    <i class="bi bi-lightbulb me-2"></i>
                    <strong>Regla Liceo:</strong> Máximo 2 evaluaciones por curso por día. Si un curso presenta "Alta carga", se sugiere revisar la distribución para evitar sobrecarga en los estudiantes.
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
