<%- include('../partials/header', { 
    title: 'Profesores', 
    active: 'admin',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/admin">Configuración</a></li><li class="breadcrumb-item active">Profesores</li></ol></nav>'
}) %>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Registrar Profesor</h6>
            </div>
            <div class="card-body">
                <form method="POST" action="/admin/profesores">
                    <div class="mb-3">
                        <label class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ej: Marcela">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Apellido <span class="text-danger">*</span></label>
                        <input type="text" name="apellido" class="form-control" required placeholder="Ej: Ríos">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="marcela.rios@liceorbl.cl">
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg me-1"></i>Guardar Profesor</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-person-badge me-2"></i>Profesores Registrados (<%= data.length %>)</h6>
            </div>
            <div class="card-body p-0">
                <% if (data.length > 0) { %>
                <!-- Vista tabla para Desktop y Tablets -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Docente</th>
                                <th>Materia / Módulo</th>
                                <th>Cursos Asignados</th>
                                <th>Email</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% data.forEach(p => { %>
                            <tr>
                                <td>
                                    <div class="fw-semibold"><%= p.nombre %> <%= p.apellido %></div>
                                    <% if (p.es_jefatura) { %>
                                        <span class="badge bg-primary text-white small" style="font-size: 0.72rem;">
                                            <i class="bi bi-star-fill me-1"></i><%= p.cargo_extra %>
                                        </span>
                                    <% } else if (p.cargo_extra) { %>
                                        <span class="badge bg-light text-secondary border small" style="font-size: 0.72rem;">
                                            <%= p.cargo_extra %>
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border"><%= p.materia || 'General' %></span>
                                </td>
                                <td>
                                    <% if (p.cursos_asignados && p.cursos_asignados.length > 0) { %>
                                        <div class="d-flex flex-wrap gap-1">
                                            <% p.cursos_asignados.forEach(cId => { 
                                                const cur = cursos.find(c => c.id === cId);
                                                if (cur) {
                                            %>
                                                <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.75rem;">
                                                    <%= cur.nombre %>
                                                </span>
                                            <%  } 
                                            }) %>
                                        </div>
                                    <% } else { %>
                                        <span class="text-muted small">Todos los cursos</span>
                                    <% } %>
                                </td>
                                <td class="text-muted small"><%= p.email || '-' %></td>
                                <td class="text-end">
                                    <form method="POST" action="/admin/profesores/<%= p.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Eliminar al profesor <%= p.nombre %> <%= p.apellido %>?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Vista tarjetas para Teléfonos Móviles (< 768px) -->
                <div class="d-md-none p-3">
                    <div class="row g-2">
                        <% data.forEach(p => { %>
                        <div class="col-12">
                            <div class="p-3 bg-white rounded border shadow-xs">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark"><%= p.nombre %> <%= p.apellido %></h6>
                                        <div class="small text-muted"><%= p.email || 'Sin correo' %></div>
                                    </div>
                                    <span class="badge bg-light text-dark border"><%= p.materia || 'General' %></span>
                                </div>
                                <% if (p.cargo_extra) { %>
                                <div class="mb-2">
                                    <span class="badge <%= p.es_jefatura ? 'bg-primary text-white' : 'bg-light text-secondary border' %>">
                                        <%= p.cargo_extra %>
                                    </span>
                                </div>
                                <% } %>
                                <div class="small mb-3">
                                    <span class="text-muted">Cursos:</span>
                                    <% if (p.cursos_asignados && p.cursos_asignados.length > 0) { %>
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            <% p.cursos_asignados.forEach(cId => { 
                                                const cur = cursos.find(c => c.id === cId);
                                                if (cur) {
                                            %>
                                                <span class="badge bg-secondary-subtle text-secondary border"><%= cur.nombre %></span>
                                            <%  } }) %>
                                        </div>
                                    <% } else { %>
                                        <span class="text-muted">Todos los cursos</span>
                                    <% } %>
                                </div>
                                <div class="pt-2 border-top text-end">
                                    <form method="POST" action="/admin/profesores/<%= p.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Eliminar al profesor <%= p.nombre %> <%= p.apellido %>?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Eliminar Profesor</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } else { %>
                <p class="text-center text-muted py-4">Aún no hay profesores registrados.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
