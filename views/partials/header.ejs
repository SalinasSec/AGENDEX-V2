<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' · AgendEx' : 'AgendEx - Sistema de Evaluaciones' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-journal-check"></i>
                <span class="brand-text">AgendEx</span>
            </div>
            <ul class="sidebar-nav">
                <li class="nav-section">PRINCIPAL</li>
                <li>
                    <a href="/" class="<%= (typeof active !== 'undefined' && active === 'dashboard') ? 'active' : '' %>">
                        <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                    </a>
                </li>

                <!-- Navegación principal -->
                <% if (current_user && current_user.rol === 'alumno') { %>
                <li class="nav-section">MIS ACTIVIDADES</li>
                <li>
                    <a href="/evaluaciones" class="<%= (typeof active !== 'undefined' && active === 'evaluaciones') ? 'active' : '' %>">
                        <i class="bi bi-clipboard-check"></i><span>Mis Evaluaciones</span>
                    </a>
                </li>
                <li>
                    <a href="/recuperaciones" class="<%= (typeof active !== 'undefined' && active === 'recuperaciones') ? 'active' : '' %> d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-arrow-counterclockwise"></i><span>Mis Recuperaciones</span>
                        </div>
                        <% if (typeof stats !== 'undefined' && stats && stats.recuperaciones_pendientes > 0) { %>
                        <span class="badge bg-danger rounded-pill"><%= stats.recuperaciones_pendientes %></span>
                        <% } %>
                    </a>
                </li>
                <% } else if (current_user) { %>
                <li class="nav-section">GESTIÓN ACADÉMICA</li>
                <li>
                    <a href="/evaluaciones" class="<%= (typeof active !== 'undefined' && active === 'evaluaciones') ? 'active' : '' %>">
                        <i class="bi bi-clipboard-check"></i><span>Evaluaciones</span>
                    </a>
                </li>
                <li>
                    <a href="/alumnos" class="<%= (typeof active !== 'undefined' && active === 'alumnos') ? 'active' : '' %>">
                        <i class="bi bi-people"></i><span>Alumnos</span>
                    </a>
                </li>
                <li>
                    <a href="/recuperaciones" class="<%= (typeof active !== 'undefined' && active === 'recuperaciones') ? 'active' : '' %>">
                        <i class="bi bi-arrow-counterclockwise"></i><span>Recuperaciones</span>
                    </a>
                </li>
                <% } %>

                <li class="nav-section">CALENDARIO & REPORTES</li>
                <li>
                    <a href="/reportes/calendario" class="<%= (typeof active !== 'undefined' && active === 'calendario') ? 'active' : '' %>">
                        <i class="bi bi-calendar3"></i><span>Calendario Escolar</span>
                    </a>
                </li>
                <% if (current_user && current_user.rol !== 'alumno') { %>
                <li>
                    <a href="/reportes/pendientes" class="<%= (typeof active !== 'undefined' && active === 'pendientes') ? 'active' : '' %>">
                        <i class="bi bi-hourglass-split"></i><span>Pendientes</span>
                    </a>
                </li>
                <li>
                    <a href="/reportes/carga" class="<%= (typeof active !== 'undefined' && active === 'carga') ? 'active' : '' %>">
                        <i class="bi bi-bar-chart-line"></i><span>Carga Académica</span>
                    </a>
                </li>
                <% } %>

                <% if (current_user && current_user.rol === 'utp') { %>
                <li class="nav-section">ADMINISTRACIÓN UTP</li>
                <li>
                    <a href="/admin/profesores" class="<%= (typeof active !== 'undefined' && active === 'profesores') ? 'active' : '' %>">
                        <i class="bi bi-person-badge"></i><span>Gestión de Profesores</span>
                    </a>
                </li>
                <li>
                    <a href="/admin" class="<%= (typeof active !== 'undefined' && active === 'admin') ? 'active' : '' %>">
                        <i class="bi bi-gear"></i><span>Configuración General</span>
                    </a>
                </li>
                <% } %>
            </ul>
            <div class="sidebar-footer">
                <small>Liceo Industrial RBL</small>
            </div>
        </nav>

        <!-- Main content -->
        <div class="main-content">
            <!-- Top navbar -->
            <nav class="topbar">
                <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1 me-2">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none flex-shrink-0" onclick="toggleSidebar()" aria-label="Abrir Menú">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="topbar-breadcrumb text-truncate">
                        <% if (typeof breadcrumb !== 'undefined' && breadcrumb) { %>
                            <%- breadcrumb %>
                        <% } else { %>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item active text-truncate"><%= typeof title !== 'undefined' ? title : 'Inicio' %></li>
                                </ol>
                            </nav>
                        <% } %>
                    </div>
                </div>
                <div class="topbar-actions d-flex align-items-center gap-2 gap-sm-3 ms-auto flex-shrink-0">
                    <span class="text-muted small d-none d-lg-inline">
                        <i class="bi bi-calendar-event"></i> <%= typeof today_formatted !== 'undefined' ? today_formatted : (new Date().toLocaleDateString('es-CL')) %>
                    </span>

                    <% if (current_user) { %>
                    <!-- Centro de Notificaciones (Campana) -->
                    <div class="dropdown">
                        <button class="btn btn-light border btn-sm position-relative px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Centro de Notificaciones">
                            <i class="bi bi-bell-fill text-secondary"></i>
                            <% if (typeof notificaciones_count !== 'undefined' && notificaciones_count > 0) { %>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.65rem;">
                                <%= notificaciones_count %>
                                <span class="visually-hidden">notificaciones</span>
                            </span>
                            <% } %>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow border p-0" style="min-width: 280px; max-width: min(380px, calc(100vw - 24px)); width: 340px;">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom">
                                <strong class="small text-uppercase"><i class="bi bi-bell me-1 text-primary"></i>Notificaciones</strong>
                                <% if (typeof notificaciones_count !== 'undefined' && notificaciones_count > 0) { %>
                                <span class="badge bg-danger rounded-pill"><%= notificaciones_count %> nueva(s)</span>
                                <% } else { %>
                                <span class="badge bg-success-subtle text-success">Al día</span>
                                <% } %>
                            </div>
                            <div class="list-group list-group-flush" style="max-height: 320px; overflow-y: auto;">
                                <% if (typeof notificaciones_usuario !== 'undefined' && notificaciones_usuario.length > 0) { %>
                                    <% notificaciones_usuario.forEach(notif => { %>
                                    <a href="<%= notif.link %>" class="list-group-item list-group-item-action p-2 px-3">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="bi <%= notif.icono || 'bi-info-circle' %> text-<%= notif.urgencia || 'primary' %> fs-5 mt-1"></i>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex justify-content-between align-items-center gap-1">
                                                    <strong class="small text-dark text-truncate"><%= notif.titulo %></strong>
                                                    <span class="badge bg-<%= notif.urgencia || 'primary' %> text-white py-0 flex-shrink-0" style="font-size: 0.68rem;"><%= notif.tiempo %></span>
                                                </div>
                                                <p class="mb-0 text-muted" style="font-size: 0.78rem; line-height: 1.25;"><%= notif.detalle %></p>
                                            </div>
                                        </div>
                                    </a>
                                    <% }) %>
                                <% } else { %>
                                    <div class="text-center py-3 text-muted small">
                                        <i class="bi bi-check2-all text-success fs-4 d-block mb-1"></i>
                                        No tienes avisos o citaciones pendientes
                                    </div>
                                <% } %>
                            </div>
                            <% if (current_user.rol === 'alumno') { %>
                            <div class="p-2 border-top bg-light text-center">
                                <a href="/recuperaciones" class="small text-decoration-none fw-semibold">Ver mis pruebas recuperativas &rarr;</a>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-light border btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" style="max-width: 200px;">
                            <% 
                                const roleColors = { utp: '#14213D', profe: '#2F6F4E', inspe: '#2C5F7A', alumno: '#A87F2C' };
                                const roleColor = roleColors[current_user.rol] || '#6c757d';
                                const roleMap = (typeof ROLES !== 'undefined' ? ROLES : { utp: 'UTP', profe: 'Profesor', inspe: 'Inspectoría', alumno: 'Alumno' });
                            %>
                            <span class="badge flex-shrink-0" style="background:<%= roleColor %>;"><%= (roleMap[current_user.rol] || current_user.rol).toUpperCase() %></span>
                            <span class="text-truncate d-none d-sm-inline small"><%= current_user.nombre %></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><span class="dropdown-item-text small text-muted"><i class="bi bi-person me-1"></i><%= current_user.nombre %></span></li>
                            <li><span class="dropdown-item-text small text-muted">Rol: <%= roleMap[current_user.rol] || current_user.rol %></span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                        </ul>
                    </div>
                    <% } %>
                </div>
            </nav>

            <!-- Flash messages -->
            <div class="container-fluid px-2 px-sm-3 px-md-4">
                <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
                <div class="mt-3">
                    <% messages.forEach(msg => { %>
                    <div class="alert alert-<%= msg.category === 'error' ? 'danger' : msg.category %> alert-dismissible fade show" role="alert">
                        <% if (msg.category === 'success') { %><i class="bi bi-check-circle-fill me-2"></i><% } %>
                        <% if (msg.category === 'danger' || msg.category === 'error') { %><i class="bi bi-exclamation-triangle-fill me-2"></i><% } %>
                        <% if (msg.category === 'warning') { %><i class="bi bi-info-circle-fill me-2"></i><% } %>
                        <%= msg.message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% }) %>
                </div>
                <% } %>

                <!-- Page content wrapper starts -->
                <div class="py-3">
