<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' · AgendEx' : 'AgendEx - Sistema de Evaluaciones' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-journal-check"></i>
                <span class="brand-text">AgendEx</span>
            </div>
            <ul class="sidebar-nav">
                <li class="nav-section">PRINCIPAL</li>
                <li>
                    <a href="/" class="<%= (typeof active !== 'undefined' && active === 'dashboard') ? 'active' : '' %>">
                        <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                    </a>
                </li>

                <!-- Navegación principal -->
                <% if (current_user && current_user.rol === 'alumno') { %>
                <li class="nav-section">MIS ACTIVIDADES</li>
                <li>
                    <a href="/evaluaciones" class="<%= (typeof active !== 'undefined' && active === 'evaluaciones') ? 'active' : '' %>">
                        <i class="bi bi-clipboard-check"></i><span>Mis Evaluaciones</span>
                    </a>
                </li>
                <li>
                    <a href="/recuperaciones" class="<%= (typeof active !== 'undefined' && active === 'recuperaciones') ? 'active' : '' %>">
                        <i class="bi bi-arrow-counterclockwise"></i><span>Mis Recuperaciones</span>
                    </a>
                </li>
                <% } else if (current_user) { %>
                <li class="nav-section">GESTIÓN ACADÉMICA</li>
                <li>
                    <a href="/evaluaciones" class="<%= (typeof active !== 'undefined' && active === 'evaluaciones') ? 'active' : '' %>">
                        <i class="bi bi-clipboard-check"></i><span>Evaluaciones</span>
                    </a>
                </li>
                <li>
                    <a href="/alumnos" class="<%= (typeof active !== 'undefined' && active === 'alumnos') ? 'active' : '' %>">
                        <i class="bi bi-people"></i><span>Alumnos</span>
                    </a>
                </li>
                <li>
                    <a href="/recuperaciones" class="<%= (typeof active !== 'undefined' && active === 'recuperaciones') ? 'active' : '' %>">
                        <i class="bi bi-arrow-counterclockwise"></i><span>Recuperaciones</span>
                    </a>
                </li>
                <% } %>

                <li class="nav-section">CALENDARIO & REPORTES</li>
                <li>
                    <a href="/reportes/calendario" class="<%= (typeof active !== 'undefined' && active === 'calendario') ? 'active' : '' %>">
                        <i class="bi bi-calendar3"></i><span>Calendario Escolar</span>
                    </a>
                </li>
                <% if (current_user && current_user.rol !== 'alumno') { %>
                <li>
                    <a href="/reportes/pendientes" class="<%= (typeof active !== 'undefined' && active === 'pendientes') ? 'active' : '' %>">
                        <i class="bi bi-hourglass-split"></i><span>Pendientes</span>
                    </a>
                </li>
                <li>
                    <a href="/reportes/carga" class="<%= (typeof active !== 'undefined' && active === 'carga') ? 'active' : '' %>">
                        <i class="bi bi-bar-chart-line"></i><span>Carga Académica</span>
                    </a>
                </li>
                <% } %>

                <% if (current_user && current_user.rol === 'utp') { %>
                <li class="nav-section">ADMINISTRACIÓN UTP</li>
                <li>
                    <a href="/admin/profesores" class="<%= (typeof active !== 'undefined' && active === 'profesores') ? 'active' : '' %>">
                        <i class="bi bi-person-badge"></i><span>Gestión de Profesores</span>
                    </a>
                </li>
                <li>
                    <a href="/admin" class="<%= (typeof active !== 'undefined' && active === 'admin') ? 'active' : '' %>">
                        <i class="bi bi-gear"></i><span>Configuración General</span>
                    </a>
                </li>
                <% } %>
            </ul>
            <div class="sidebar-footer">
                <small>Liceo Industrial RBL</small>
            </div>
        </nav>

        <!-- Main content -->
        <div class="main-content">
            <!-- Top navbar -->
            <nav class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-md-none" onclick="toggleSidebar()" aria-label="Menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <% if (typeof breadcrumb !== 'undefined' && breadcrumb) { %>
                            <%- breadcrumb %>
                        <% } else { %>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item active"><%= typeof title !== 'undefined' ? title : 'Inicio' %></li>
                                </ol>
                            </nav>
                        <% } %>
                    </div>
                </div>
                <div class="topbar-actions d-flex align-items-center gap-3">
                    <span class="text-muted small d-none d-md-inline">
                        <i class="bi bi-calendar-event"></i> <%= typeof today_formatted !== 'undefined' ? today_formatted : (new Date().toLocaleDateString('es-CL')) %>
                    </span>
                    <% if (current_user) { %>
                    <div class="dropdown">
                        <button class="btn btn-light border btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <% 
                                const roleColors = { utp: '#14213D', profe: '#2F6F4E', inspe: '#2C5F7A', alumno: '#A87F2C' };
                                const roleColor = roleColors[current_user.rol] || '#6c757d';
                                const roleMap = (typeof ROLES !== 'undefined' ? ROLES : { utp: 'UTP', profe: 'Profesor', inspe: 'Inspectoría', alumno: 'Alumno' });
                            %>
                            <span class="badge" style="background:<%= roleColor %>; margin-right:6px;"><%= (roleMap[current_user.rol] || current_user.rol).toUpperCase() %></span>
                            <i class="bi bi-person-circle me-1"></i> <%= current_user.nombre %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text small text-muted">Rol: <%= roleMap[current_user.rol] || current_user.rol %></span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                        </ul>
                    </div>
                    <% } %>
                </div>
            </nav>

            <!-- Flash messages -->
            <div class="container-fluid px-4">
                <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
                <div class="mt-3">
                    <% messages.forEach(msg => { %>
                    <div class="alert alert-<%= msg.category === 'error' ? 'danger' : msg.category %> alert-dismissible fade show" role="alert">
                        <% if (msg.category === 'success') { %><i class="bi bi-check-circle-fill me-2"></i><% } %>
                        <% if (msg.category === 'danger' || msg.category === 'error') { %><i class="bi bi-exclamation-triangle-fill me-2"></i><% } %>
                        <% if (msg.category === 'warning') { %><i class="bi bi-info-circle-fill me-2"></i><% } %>
                        <%= msg.message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% }) %>
                </div>
                <% } %>

                <!-- Page content wrapper starts -->
                <div class="py-3">
