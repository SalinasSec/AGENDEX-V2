<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión · AgendEx</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="/css/login.css" rel="stylesheet">
</head>
<body>
    <main class="pantalla">

        <section class="panel-marca">
            <div class="marca-contenido">
                <span class="marca-nombre">AgendEx</span>
                <p class="marca-frase">Agendamiento y control de evaluaciones escolares.</p>
            </div>

            <svg class="patron" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
                <line x1="0" y1="80" x2="400" y2="80" />
                <line x1="0" y1="160" x2="400" y2="160" />
                <line x1="0" y1="240" x2="400" y2="240" />
                <line x1="0" y1="320" x2="400" y2="320" />
                <line x1="100" y1="0" x2="100" y2="400" />
                <line x1="200" y1="0" x2="200" y2="400" />
                <line x1="300" y1="0" x2="300" y2="400" />
                <circle cx="300" cy="240" r="5" />
                <circle cx="100" cy="160" r="5" />
                <circle cx="200" cy="320" r="5" />
            </svg>

            <p class="marca-pie">Alumnos · Profesores · UTP · Inspectoría</p>
        </section>

        <section class="panel-formulario">
            <div class="formulario-envoltorio">

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="aviso aviso-danger">
                        <%= error %>
                    </div>
                <% } %>
                <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
                    <% messages.forEach(msg => { %>
                    <div class="aviso aviso-<%= msg.category === 'error' ? 'danger' : msg.category %>">
                        <%= msg.message %>
                    </div>
                    <% }) %>
                <% } %>

                <header class="formulario-encabezado">
                    <h1>Inicia sesión</h1>
                    <p class="rol-frase">Ingresa tus credenciales institucionales para acceder.</p>
                </header>

                <form class="formulario" method="POST" action="/auth/login">
                    <div class="campo">
                        <label for="correo" class="campo-etiqueta">Correo institucional</label>
                        <input type="email" id="correo" name="correo" class="campo-input" value="<%= typeof correo !== 'undefined' ? correo : '' %>" placeholder="ejemplo@liceorbl.cl" required autocomplete="username" autofocus>
                    </div>

                    <div class="campo">
                        <label for="password" class="campo-etiqueta">Contraseña</label>
                        <input type="password" id="password" name="password" class="campo-input" value="" placeholder="••••••••" required autocomplete="current-password">
                    </div>

                    <button type="submit" class="boton-entrar">
                        <span class="boton-texto">Entrar</span>
                        <span class="spinner" aria-hidden="true"></span>
                    </button>
                </form>

                <div class="demo-accesos">
                    <span class="demo-titulo">Perfiles de prueba rápida (clic para entrar directamente):</span>
                    <div class="demo-botones">
                        <button type="button" class="btn-demo" data-correo="utp@liceorbl.cl" data-clave="utp123" data-rol="utp">UTP</button>
                        <button type="button" class="btn-demo" data-correo="marcela.rubio@liceorbl.cl" data-clave="profe123" data-rol="profe" title="Jefa 4°G - M8 Web">Prof. Marcela (4°G)</button>
                        <button type="button" class="btn-demo" data-correo="antonio.velasquez@liceorbl.cl" data-clave="profe123" data-rol="profe" title="Jefe 3°G - M5/M6/M7">Prof. Antonio (3°G)</button>
                        <button type="button" class="btn-demo" data-correo="inspe.diaz@liceorbl.cl" data-clave="inspe123" data-rol="inspe">Inspectoría</button>
                        <button type="button" class="btn-demo" data-correo="joaquin.rivas@liceorbl.cl" data-clave="alumno123" data-rol="alumno">Alumno 4°G</button>
                    </div>
                </div>

                <div id="avisoIframe" style="display: none; margin-top: 14px; padding: 10px 12px; background: rgba(52, 152, 219, 0.1); border: 1px solid rgba(52, 152, 219, 0.3); border-radius: 8px; font-size: 13px; color: #1e3a8a; text-align: center;">
                    <span>¿Tu navegador bloquea cookies en la vista previa?</span><br>
                    <a href="/" target="_blank" style="color: #2563eb; font-weight: 600; text-decoration: underline; display: inline-block; margin-top: 4px;">
                        Abrir aplicación en pestaña nueva ↗
                    </a>
                </div>

                <p class="pie-registro">Plataforma de gestión académica · Liceo Industrial RBL</p>
            </div>
        </section>

    </main>

    <script>
        const formulario = document.querySelector('.formulario');
        const boton = document.querySelector('.boton-entrar');
        const panelFormulario = document.querySelector('.panel-formulario');
        const campoCorreo = document.getElementById('correo');
        const campoPassword = document.getElementById('password');
        const avisoError = document.querySelector('.aviso-danger');
        const demoBotones = document.querySelectorAll('.btn-demo');
        const avisoIframe = document.getElementById('avisoIframe');

        // Detectar si está ejecutándose dentro de un iframe (como la vista previa de AI Studio)
        try {
            if (window.self !== window.top && avisoIframe) {
                avisoIframe.style.display = 'block';
            }
        } catch (e) {
            if (avisoIframe) avisoIframe.style.display = 'block';
        }

        demoBotones.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                campoCorreo.value = btn.dataset.correo;
                campoPassword.value = btn.dataset.clave;
                boton.classList.add('loading');
                formulario.submit();
            });
        });

        requestAnimationFrame(() => {
            panelFormulario.classList.add('animado');
        });

        if (avisoError) {
            formulario.classList.add('error');
            formulario.addEventListener('animationend', () => {
                formulario.classList.remove('error');
            }, { once: true });
        }

        campoCorreo.addEventListener('keydown', (evento) => {
            if (evento.key === 'Enter') {
                evento.preventDefault();
                campoPassword.focus();
            }
        });

        formulario.addEventListener('submit', () => {
            boton.classList.add('loading');
        });
    </script>
</body>
</html>
