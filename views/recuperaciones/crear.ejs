<%- include('../partials/header', { 
    title: 'Nueva Recuperación', 
    active: 'recuperaciones',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/recuperaciones">Recuperaciones</a></li><li class="breadcrumb-item active">Nueva Recuperación</li></ol></nav>'
}) %>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Asignar Fecha de Recuperación</h5>
            </div>
            <div class="card-body">
                <form method="POST" action="/recuperaciones/crear">
                    <div class="alert alert-info small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        La exigencia de la recuperación se calcula automáticamente según la normativa: si Inspectoría/UTP marcó la inasistencia como <strong>justificada</strong>, el alumno rinde con un <strong>60%</strong> de exigencia. Si la inasistencia no fue justificada, rinde con un <strong>70%</strong> de exigencia.
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Evaluación original <span class="text-danger">*</span></label>
                            <select name="evaluacion_id" id="evalSelect" class="form-select" required>
                                <option value="">Seleccionar evaluación...</option>
                                <% evaluaciones.forEach(ev => { %>
                                <option value="<%= ev.id %>"><%= ev.titulo %> — <%= ev.curso.nombre %> (<%= ev.fecha %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Alumno <span class="text-danger">*</span></label>
                            <select name="alumno_id" class="form-select" required>
                                <option value="">Seleccionar alumno...</option>
                                <% alumnos.forEach(a => { %>
                                <option value="<%= a.id %>" <%= alumno_id_preselect == a.id ? 'selected' : '' %>><%= a.nombre_completo %> — <%= a.curso ? a.curso.nombre : '' %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label">Fecha de recuperación <span class="text-danger">*</span></label>
                            <input type="date" name="fecha_recuperacion" class="form-control" required min="<%= hoy %>" value="<%= hoy %>">
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label">Exigencia reglamentaria</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-shield-check"></i></span>
                                <input type="text" class="form-control bg-light" value="Automática (60% / 70%)" readonly>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Motivo o justificación</label>
                            <input type="text" name="motivo" class="form-control" placeholder="Ej: Ausencia por licencia médica, inasistencia justificada...">
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex flex-wrap justify-content-end gap-2">
                        <a href="/recuperaciones" class="btn btn-outline-secondary w-100 w-sm-auto text-center">Cancelar</a>
                        <button type="submit" class="btn btn-warning w-100 w-sm-auto"><i class="bi bi-check-lg me-1"></i>Asignar Recuperación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
