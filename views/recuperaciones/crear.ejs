<%- include('../partials/header', { 
    title: 'Programar Recuperación', 
    active: 'recuperaciones',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/recuperaciones">Recuperaciones</a></li><li class="breadcrumb-item active">Programar Recuperación</li></ol></nav>'
}) %>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-primary text-white me-2 fs-6"><i class="bi bi-person-video3"></i> Rol Docente</span>
                        <h5 class="card-title mb-0 fw-bold">Programar Evaluación Recuperativa</h5>
                    </div>
                    <span class="badge bg-light text-muted border">Exclusivo Profesores</span>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Marco normativo y división de roles -->
                <div class="alert alert-light border border-primary-subtle mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-info-circle-fill text-primary fs-4 mt-1"></i>
                        <div>
                            <strong class="d-block text-dark mb-1">Criterio Reglamentario del Liceo:</strong>
                            <p class="small text-muted mb-2">
                                Como docente, tu labor es únicamente <strong>agendar la citación y los contenidos a evaluar</strong> para el estudiante que estuvo ausente.
                            </p>
                            <ul class="small text-muted mb-0 ps-3">
                                <li class="mb-1"><strong>Exigencia Inicial (70%):</strong> La evaluación recuperativa se genera automáticamente con <span class="badge bg-danger">70% de exigencia</span> (inasistencia sin justificar).</li>
                                <li><strong>Acreditación en Inspectoría:</strong> Si el estudiante o apoderado presenta certificado médico ante <strong>Inspectoría General</strong>, Inspectoría validará el documento y el sistema rebajará automáticamente la exigencia al <span class="badge bg-success">60% regular</span>.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <form method="POST" action="/recuperaciones/crear" id="formRecuperacion">
                    <div class="row g-3">
                        <!-- Selección de Evaluación -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">1. Evaluación Original <span class="text-danger">*</span></label>
                            <select name="evaluacion_id" id="evalSelect" class="form-select" required>
                                <option value="">-- Seleccionar evaluación original del curso --</option>
                                <% evaluaciones.forEach(ev => { %>
                                    <% const cursoNombre = ev.curso ? ev.curso.nombre : (ev.curso_id ? 'Curso #' + ev.curso_id : 'Sin Curso'); %>
                                    <% const asigNombre = ev.asignatura ? ev.asignatura.nombre : 'Asignatura'; %>
                                    <option value="<%= ev.id %>" 
                                            data-curso-id="<%= ev.curso_id %>"
                                            <%= (typeof evaluacion_id_preselect !== 'undefined' && evaluacion_id_preselect == ev.id) ? 'selected' : '' %>>
                                        <%= ev.titulo %> • <%= cursoNombre %> (<%= ev.fecha %>) — [<%= asigNombre %>]
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Selección de Alumno -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">2. Estudiante Ausente a Evaluar <span class="text-danger">*</span></label>
                            <select name="alumno_id" id="alumnoSelect" class="form-select" required>
                                <option value="">-- Seleccionar estudiante ausente --</option>
                                <% alumnos.forEach(a => { %>
                                    <% const cursoAlumno = a.curso ? a.curso.nombre : ''; %>
                                    <option value="<%= a.id %>" 
                                            data-curso-id="<%= a.curso_id %>"
                                            <%= (typeof alumno_id_preselect !== 'undefined' && alumno_id_preselect == a.id) ? 'selected' : '' %>>
                                        <%= a.nombre_completo || (a.nombre + ' ' + a.apellido) %> (<%= a.rut %>)<%= cursoAlumno ? ' — Curso ' + cursoAlumno : '' %>
                                    </option>
                                <% }) %>
                            </select>
                            <div class="form-text" id="filtroTextoAyuda">Al seleccionar una evaluación, se destacarán los estudiantes de ese curso en color azul.</div>
                        </div>

                        <!-- Fecha de Recuperación -->
                        <div class="col-12 col-md-7">
                            <label class="form-label fw-semibold">3. Fecha de Rendición de la Recuperativa <span class="text-danger">*</span></label>
                            <input type="date" name="fecha_recuperacion" class="form-control" required min="<%= hoy %>" value="<%= hoy %>">
                            <div class="form-text">Día en que el estudiante deberá presentarse a rendir la prueba.</div>
                        </div>

                        <!-- Hora / Bloque opcional -->
                        <div class="col-12 col-md-5">
                            <label class="form-label fw-semibold">4. Hora / Bloque o Sala <span class="text-muted small">(Opcional)</span></label>
                            <input type="text" name="hora_recuperacion" class="form-control" placeholder="Ej: 14:15 hrs o Bloque 3">
                        </div>

                        <!-- Indicaciones pedagógicas o temario -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">5. Indicaciones o Temario para el Estudiante <span class="text-muted small">(Opcional)</span></label>
                            <input type="text" name="indicaciones" id="indicacionesInput" class="form-control" 
                                   placeholder="Ej: Traer calculadora y regla; temario: Unidad 2 Leyes de Newton.">
                            <div class="form-text">Instrucciones o materiales que el estudiante verá en su citación.</div>
                        </div>

                        <!-- Cuadro informativo de exigencia automática -->
                        <div class="col-12">
                            <div class="p-3 rounded border bg-danger-subtle border-danger text-danger-emphasis d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-shield-exclamation fs-3 text-danger"></i>
                                    <div>
                                        <div class="fw-bold">Exigencia Asignada Inicialmente: 70%</div>
                                        <div class="small text-muted">
                                            La citación se registra con 70%. Cuando el estudiante acredite su certificado médico en <strong>Inspectoría General</strong>, la exigencia pasará de inmediato al 60%.
                                        </div>
                                    </div>
                                </div>
                                <span class="badge bg-danger fs-5 px-3 py-2">70%</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <a href="/recuperaciones" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Volver a Recuperaciones
                        </a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                            <i class="bi bi-calendar-plus me-1"></i> Programar Evaluación Recuperativa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer', {
    scripts: `
<script>
document.addEventListener('DOMContentLoaded', () => {
    const evalSelect = document.getElementById('evalSelect');
    const alumnoSelect = document.getElementById('alumnoSelect');

    // Filtrar y destacar alumnos según curso de la evaluación seleccionada
    function sincronizarAlumnosPorCurso() {
        const selectedOption = evalSelect.options[evalSelect.selectedIndex];
        const cursoId = selectedOption ? selectedOption.getAttribute('data-curso-id') : null;
        if (!cursoId) return;

        let primeraCoincidencia = null;
        for (let i = 0; i < alumnoSelect.options.length; i++) {
            const opt = alumnoSelect.options[i];
            const optCurso = opt.getAttribute('data-curso-id');
            if (optCurso === cursoId) {
                opt.style.fontWeight = 'bold';
                opt.style.color = '#0d6efd';
                if (!primeraCoincidencia && opt.value) {
                    primeraCoincidencia = opt.value;
                }
            } else {
                opt.style.fontWeight = 'normal';
                opt.style.color = '';
            }
        }
    }

    evalSelect.addEventListener('change', sincronizarAlumnosPorCurso);
    sincronizarAlumnosPorCurso();
});
</script>
`
}) %>
