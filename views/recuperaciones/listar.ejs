<%- include('../partials/header', { 
    title: 'Recuperaciones', 
    active: 'recuperaciones',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item active">Recuperaciones</li></ol></nav>'
}) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="mb-0"><i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Recuperaciones de Evaluaciones</h4>
        <small class="text-muted">Gestión de justificaciones médicas, salidas pedagógicas e inasistencias</small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <% if (current_user.rol === 'inspe') { %>
        <a href="/recuperaciones/crear" class="btn btn-warning">
            <i class="bi bi-plus-circle me-1"></i>Nueva Recuperación
        </a>
        <% } else if (current_user.rol === 'utp') { %>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-2 px-3">
            <i class="bi bi-eye me-1"></i>Supervisión General UTP
        </span>
        <% } %>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap gap-2" role="group">
            <a href="/recuperaciones" class="btn btn-sm <%= !filtros.estado ? 'btn-primary' : 'btn-outline-primary' %>">Todas</a>
            <a href="/recuperaciones?estado=pendiente" class="btn btn-sm <%= filtros.estado === 'pendiente' ? 'btn-warning' : 'btn-outline-warning' %>">Pendientes</a>
            <a href="/recuperaciones?estado=completada" class="btn btn-sm <%= filtros.estado === 'completada' ? 'btn-success' : 'btn-outline-success' %>">Completadas</a>
            <a href="/recuperaciones?estado=cancelada" class="btn btn-sm <%= filtros.estado === 'cancelada' ? 'btn-secondary' : 'btn-outline-secondary' %>">Canceladas</a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <% if (recuperaciones.length > 0) { %>
        <!-- Vista de tabla para PC, Laptop y Tablets -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover mb-0 align-middle" style="min-width: 760px;">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 140px;">Alumno</th>
                        <th style="min-width: 150px;">Evaluación original</th>
                        <th class="nowrap">Fecha original</th>
                        <th class="nowrap">Fecha recup.</th>
                        <th class="nowrap">Tipo & Exigencia</th>
                        <th style="min-width: 130px;">Motivo / Folio</th>
                        <th class="nowrap">Estado</th>
                        <% if (['inspe','profe'].includes(current_user.rol)) { %>
                        <th class="text-end nowrap">Acciones</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% recuperaciones.forEach(rec => { %>
                    <tr>
                        <td>
                            <a href="/alumnos/<%= rec.alumno_id %>" class="text-decoration-none fw-semibold">
                                <%= rec.alumno ? (rec.alumno.nombre_completo || rec.alumno.nombre) : 'Alumno' %>
                            </a>
                            <br><small class="text-muted"><%= (rec.alumno && rec.alumno.curso) ? rec.alumno.curso.nombre : '' %></small>
                        </td>
                        <td>
                            <a href="/evaluaciones/<%= rec.evaluacion_id %>" class="text-decoration-none">
                                <%= rec.evaluacion ? rec.evaluacion.titulo : 'Evaluación' %>
                            </a>
                        </td>
                        <td class="nowrap text-muted small"><%= rec.evaluacion ? rec.evaluacion.fecha : '-' %></td>
                        <td class="nowrap">
                            <span class="badge bg-light text-dark border fw-semibold"><i class="bi bi-calendar-event me-1 text-primary"></i><%= rec.fecha_recuperacion %></span>
                        </td>
                        <td class="nowrap">
                            <% 
                                const esSalida = (rec.tipo_justificacion === 'salida_pedagogica') || (rec.motivo && rec.motivo.toLowerCase().includes('salida'));
                                const esInjust = (rec.tipo_justificacion === 'injustificada') || (Number(rec.porcentaje_exigencia) >= 70);
                            %>
                            <% if (esInjust) { %>
                                <span class="badge bg-danger" title="Sin justificativo válido">
                                    <i class="bi bi-exclamation-octagon me-1"></i>70% Injustificada
                                </span>
                            <% } else if (esSalida) { %>
                                <span class="badge bg-info text-dark" title="Salida pedagógica autorizada por Inspectoría">
                                    <i class="bi bi-bus-front me-1"></i>60% Salida Pedagógica
                                </span>
                            <% } else { %>
                                <span class="badge bg-success" title="Certificado médico acreditado">
                                    <i class="bi bi-file-earmark-medical me-1"></i>60% Certificado Médico
                                </span>
                            <% } %>
                        </td>
                        <td class="text-muted small"><%= rec.motivo || '-' %></td>
                        <td class="nowrap">
                            <% if (rec.estado === 'pendiente') { %>
                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pendiente</span>
                            <% } else if (rec.estado === 'completada') { %>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completada</span>
                            <% } else { %>
                            <span class="badge bg-secondary">Cancelada</span>
                            <% } %>
                        </td>
                        <% if (['inspe','profe'].includes(current_user.rol)) { %>
                        <td class="text-end nowrap">
                            <% if (rec.estado === 'pendiente') { %>
                            <form method="POST" action="/recuperaciones/<%= rec.id %>/completar" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success" title="Rendida / Completada"><i class="bi bi-check-lg"></i></button>
                            </form>
                            <form method="POST" action="/recuperaciones/<%= rec.id %>/cancelar" class="d-inline" onsubmit="return confirm('¿Deseas cancelar esta programación de recuperación?')">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancelar"><i class="bi bi-x-lg"></i></button>
                            </form>
                            <% } %>
                        </td>
                        <% } %>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Vista de tarjetas móviles (wrap natural) para Celulares -->
        <div class="d-md-none p-3">
            <div class="row g-3">
                <% recuperaciones.forEach(rec => { %>
                <div class="col-12">
                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <a href="/alumnos/<%= rec.alumno_id %>" class="fw-bold text-decoration-none">
                                    <%= rec.alumno ? (rec.alumno.nombre_completo || rec.alumno.nombre) : 'Alumno' %>
                                </a>
                                <div class="small text-muted"><%= (rec.alumno && rec.alumno.curso) ? rec.alumno.curso.nombre : '' %></div>
                            </div>
                            <% if (rec.estado === 'pendiente') { %>
                            <span class="badge bg-warning text-dark">Pendiente</span>
                            <% } else if (rec.estado === 'completada') { %>
                            <span class="badge bg-success">Completada</span>
                            <% } else { %>
                            <span class="badge bg-secondary">Cancelada</span>
                            <% } %>
                        </div>
                        <div class="small mb-1">
                            <span class="text-muted">Evaluación:</span>
                            <a href="/evaluaciones/<%= rec.evaluacion_id %>" class="text-decoration-none fw-semibold">
                                <%= rec.evaluacion ? rec.evaluacion.titulo : 'Evaluación' %>
                            </a>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center small my-2">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-calendar-check me-1"></i>Recup: <%= rec.fecha_recuperacion %>
                            </span>
                            <% 
                                const esSalidaMob = (rec.tipo_justificacion === 'salida_pedagogica') || (rec.motivo && rec.motivo.toLowerCase().includes('salida'));
                                const esInjustMob = (rec.tipo_justificacion === 'injustificada') || (Number(rec.porcentaje_exigencia) >= 70);
                            %>
                            <% if (esInjustMob) { %>
                                <span class="badge bg-danger">70% Injustificada</span>
                            <% } else if (esSalidaMob) { %>
                                <span class="badge bg-info text-dark">60% Salida Pedagógica</span>
                            <% } else { %>
                                <span class="badge bg-success">60% Certificado Médico</span>
                            <% } %>
                        </div>
                        <% if (rec.motivo) { %>
                        <div class="small text-muted fst-italic mb-2">
                            <%= rec.motivo %>
                        </div>
                        <% } %>
                        <% if (rec.estado === 'pendiente' && ['inspe','profe'].includes(current_user.rol)) { %>
                        <div class="d-flex gap-2 mt-2 pt-2 border-top">
                            <form method="POST" action="/recuperaciones/<%= rec.id %>/completar" class="flex-grow-1">
                                <button type="submit" class="btn btn-sm btn-success w-100"><i class="bi bi-check-lg me-1"></i>Completar</button>
                            </form>
                            <form method="POST" action="/recuperaciones/<%= rec.id %>/cancelar" onsubmit="return confirm('¿Cancelar esta recuperación?')">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancelar"><i class="bi bi-x-lg"></i></button>
                            </form>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } else { %>
        <div class="text-center py-5 text-muted">
            <i class="bi bi-check-circle display-1 text-success"></i>
            <p class="mt-3">No hay recuperaciones en esta categoría.</p>
            <% if (current_user.rol === 'inspe') { %>
            <a href="/recuperaciones/crear" class="btn btn-warning"><i class="bi bi-plus-circle me-1"></i>Asignar nueva recuperación</a>
            <% } %>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
