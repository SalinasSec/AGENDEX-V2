<%- include('../partials/header', { 
    title: 'Recuperaciones', 
    active: 'recuperaciones',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item active">Recuperaciones</li></ol></nav>'
}) %>

<!-- Encabezado y Roles -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <% if (current_user && current_user.rol === 'inspe') { %>
        <h4 class="mb-0"><i class="bi bi-file-earmark-medical me-2 text-success"></i>Inspectoría General &mdash; Acreditación de Certificados Médicos</h4>
        <small class="text-muted">Acreditación de licencias y justificativos para rebajar exigencia reglamentaria (70% &rarr; 60%)</small>
        <% } else if (current_user && current_user.rol === 'profe') { %>
        <h4 class="mb-0"><i class="bi bi-arrow-counterclockwise me-2 text-warning"></i>Evaluaciones Recuperativas</h4>
        <small class="text-muted">Programación de citaciones, aplicación de pruebas y registro de rendición</small>
        <% } else { %>
        <h4 class="mb-0"><i class="bi bi-arrow-counterclockwise me-2 text-primary"></i>Módulo de Recuperaciones</h4>
        <small class="text-muted">Supervisión y consulta de citaciones y exigencia reglamentaria</small>
        <% } %>
    </div>
    <div class="d-flex align-items-center gap-2">
        <% if (current_user && current_user.rol === 'profe') { %>
        <a href="/recuperaciones/crear" class="btn btn-warning fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Programar Recuperación
        </a>
        <% } else if (current_user && current_user.rol === 'inspe') { %>
        <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-3 fs-6">
            <i class="bi bi-shield-check me-1"></i>Inspectoría: Acreditación Médica
        </span>
        <% } else if (current_user && current_user.rol === 'utp') { %>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-2 px-3">
            <i class="bi bi-eye me-1"></i>Supervisión Institucional UTP
        </span>
        <% } %>
    </div>
</div>

<!-- Banner Explicativo según Rol -->
<% if (current_user && current_user.rol === 'inspe') { %>
<div class="alert alert-success bg-success bg-opacity-10 border border-success-subtle py-3 mb-4 shadow-xs">
    <div class="d-flex align-items-start gap-3">
        <i class="bi bi-shield-check text-success fs-3 mt-1"></i>
        <div>
            <h6 class="fw-bold text-success-emphasis mb-1">Módulo Exclusivo de Inspectoría General</h6>
            <p class="small text-muted mb-0">
                Tu labor en este módulo es <strong>acreditar los certificados médicos y licencias oficiales</strong> de los estudiantes ausentes con su número de folio. Al acreditar el documento, <strong>la exigencia del estudiante se rebajará automáticamente del 70% al 60% regular</strong>. La fijación de fechas de pruebas, aplicación en sala y calificación (rendida o nota 1.1) corresponde exclusivamente a los profesores.
            </p>
        </div>
    </div>
</div>
<% } else if (current_user && current_user.rol === 'profe') { %>
<div class="alert alert-primary bg-primary bg-opacity-10 border border-primary-subtle py-3 mb-4 shadow-xs">
    <div class="d-flex align-items-start gap-3">
        <i class="bi bi-person-video3 text-primary fs-3 mt-1"></i>
        <div>
            <h6 class="fw-bold text-primary-emphasis mb-1">Módulo Docente de Evaluaciones Recuperativas</h6>
            <p class="small text-muted mb-0">
                Como profesor de asignatura, programa aquí las pruebas recuperativas para los estudiantes ausentes fijando fecha y contenidos. La prueba se crea automáticamente al <strong>70% de exigencia inicial</strong>; si el estudiante presenta certificado médico en <strong>Inspectoría General</strong>, Inspectoría lo acreditará y la exigencia se rebajará automáticamente al <strong>60%</strong>. Una vez rendida la prueba, marca su estado como <em>Rendida</em> o <em>No se presentó (Nota 1.1)</em>.
            </p>
        </div>
    </div>
</div>
<% } else if (current_user && current_user.rol === 'alumno') { %>
<div class="alert alert-warning bg-warning bg-opacity-10 border border-warning-subtle py-3 mb-4 shadow-xs">
    <div class="d-flex align-items-start gap-3">
        <i class="bi bi-info-circle-fill text-warning fs-3 mt-1"></i>
        <div>
            <h6 class="fw-bold mb-1">Tus Evaluaciones Recuperativas</h6>
            <p class="small text-muted mb-0">
                Revisa aquí las fechas fijadas por tus profesores para rendir pruebas pendientes. Si justificaste tu inasistencia con <strong>certificado médico en Inspectoría General</strong>, tu exigencia será del <strong>60% regular</strong>. Si la inasistencia fue injustificada o aún no presentas certificado en Inspectoría, rendirás al <strong>70% de exigencia</strong>.
            </p>
        </div>
    </div>
</div>
<% } %>

<!-- Pestañas de Filtro adaptadas por Rol -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body py-2 px-3">
        <% if (current_user && current_user.rol === 'inspe') { %>
        <!-- Filtros específicos para Inspectoría: Enfocados en la acreditación médica -->
        <div class="d-flex flex-wrap gap-2 align-items-center" role="group">
            <span class="small fw-semibold text-muted me-2"><i class="bi bi-funnel me-1"></i>Filtro Inspectoría:</span>
            <a href="/recuperaciones" class="btn btn-sm <%= (!filtros.tipo && !filtros.estado) ? 'btn-success' : 'btn-outline-secondary' %>">
                Todas las citaciones
            </a>
            <a href="/recuperaciones?tipo=pendientes_medico" class="btn btn-sm <%= filtros.tipo === 'pendientes_medico' ? 'btn-danger' : 'btn-outline-danger' %>">
                <i class="bi bi-clock-history me-1"></i>Pendientes de Certificado Médico (70% Exigencia)
            </a>
            <a href="/recuperaciones?tipo=acreditadas" class="btn btn-sm <%= filtros.tipo === 'acreditadas' ? 'btn-success' : 'btn-outline-success' %>">
                <i class="bi bi-file-earmark-medical me-1"></i>Certificados Acreditados (60% Exigencia)
            </a>
            <a href="/recuperaciones?tipo=salida" class="btn btn-sm <%= filtros.tipo === 'salida' ? 'btn-info' : 'btn-outline-info' %>">
                <i class="bi bi-bus-front me-1"></i>Salidas Pedagógicas (60%)
            </a>
        </div>
        <% } else { %>
        <!-- Filtros para Profesores, Alumnos y UTP: Enfocados en el estado de aplicación de la prueba -->
        <div class="d-flex flex-wrap gap-2 align-items-center" role="group">
            <span class="small fw-semibold text-muted me-2"><i class="bi bi-funnel me-1"></i>Estado prueba:</span>
            <a href="/recuperaciones" class="btn btn-sm <%= !filtros.estado ? 'btn-primary' : 'btn-outline-secondary' %>">Todas</a>
            <a href="/recuperaciones?estado=pendiente" class="btn btn-sm <%= filtros.estado === 'pendiente' ? 'btn-warning' : 'btn-outline-warning' %>">
                <i class="bi bi-clock me-1"></i>Pendientes por rendir
            </a>
            <a href="/recuperaciones?estado=completada" class="btn btn-sm <%= filtros.estado === 'completada' ? 'btn-success' : 'btn-outline-success' %>">
                <i class="bi bi-check-circle me-1"></i>Rendidas
            </a>
            <a href="/recuperaciones?estado=no_presento" class="btn btn-sm <%= filtros.estado === 'no_presento' ? 'btn-danger' : 'btn-outline-danger' %>">
                <i class="bi bi-x-octagon me-1"></i>No se presentó (Nota 1.1)
            </a>
            <a href="/recuperaciones?estado=cancelada" class="btn btn-sm <%= filtros.estado === 'cancelada' ? 'btn-secondary' : 'btn-outline-secondary' %>">Canceladas</a>
        </div>
        <% } %>
    </div>
</div>

<!-- Listado Principal -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <% if (recuperaciones.length > 0) { %>
        <!-- Tabla para Escritorio / Pantallas grandes -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover mb-0 align-middle" style="min-width: 820px;">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 160px;">Estudiante</th>
                        <th style="min-width: 170px;">Evaluación & Profesor</th>
                        <th class="nowrap" style="min-width: 110px;">Fecha Citación</th>
                        <th class="nowrap" style="min-width: 140px;">Exigencia Reglamentaria</th>
                        <th style="min-width: 160px;">
                            <%= (current_user && current_user.rol === 'inspe') ? 'Certificado Médico / Folio' : 'Motivo / Indicaciones' %>
                        </th>
                        <% if (current_user && current_user.rol === 'inspe') { %>
                        <th class="text-end nowrap" style="min-width: 180px;">Acreditación Inspectoría</th>
                        <% } else { %>
                        <th class="nowrap" style="min-width: 110px;">Estado Prueba</th>
                        <% if (current_user && current_user.rol === 'profe') { %>
                        <th class="text-end nowrap" style="min-width: 150px;">Acciones Docente</th>
                        <% } %>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% recuperaciones.forEach(rec => { %>
                    <% 
                        const exigenciaNum = Number(rec.porcentaje_exigencia);
                        const esInjust = (rec.tipo_justificacion === 'injustificada') || (exigenciaNum >= 70);
                        const esSalida = (rec.tipo_justificacion === 'salida_pedagogica') || (rec.motivo && rec.motivo.toLowerCase().includes('salida'));
                        const profNombre = (rec.evaluacion && rec.evaluacion.profesor) ? rec.evaluacion.profesor.nombre_completo : 'Docente';
                    %>
                    <tr>
                        <td>
                            <a href="/alumnos/<%= rec.alumno_id %>" class="text-decoration-none fw-semibold">
                                <%= rec.alumno ? (rec.alumno.nombre_completo || rec.alumno.nombre) : 'Estudiante' %>
                            </a>
                            <div class="text-muted small">
                                <%= rec.alumno ? (rec.alumno.rut || '') : '' %>
                                <%= (rec.alumno && rec.alumno.curso) ? ' • ' + rec.alumno.curso.nombre : '' %>
                            </div>
                        </td>
                        <td>
                            <a href="/evaluaciones/<%= rec.evaluacion_id %>" class="text-decoration-none fw-semibold">
                                <%= rec.evaluacion ? rec.evaluacion.titulo : 'Evaluación' %>
                            </a>
                            <div class="text-muted small">
                                <i class="bi bi-person me-1"></i><%= profNombre %>
                                <% if (rec.evaluacion && rec.evaluacion.fecha) { %>
                                • Orig: <%= rec.evaluacion.fecha %>
                                <% } %>
                            </div>
                        </td>
                        <td class="nowrap">
                            <span class="badge bg-light text-dark border fw-semibold">
                                <i class="bi bi-calendar-event me-1 text-primary"></i><%= rec.fecha_recuperacion %>
                            </span>
                            <% if (rec.hora_recuperacion) { %>
                            <div class="small text-muted mt-1"><i class="bi bi-clock me-1"></i><%= rec.hora_recuperacion %></div>
                            <% } %>
                        </td>
                        <td class="nowrap">
                            <% if (esInjust) { %>
                                <span class="badge bg-danger fs-7" title="Inasistencia sin justificar ante Inspectoría">
                                    <i class="bi bi-exclamation-octagon me-1"></i>70% Sin justificar
                                </span>
                            <% } else if (esSalida) { %>
                                <span class="badge bg-info text-dark fs-7" title="Salida pedagógica autorizada">
                                    <i class="bi bi-bus-front me-1"></i>60% Salida Oficial
                                </span>
                            <% } else { %>
                                <span class="badge bg-success fs-7" title="Certificado médico recepcionado en Inspectoría">
                                    <i class="bi bi-file-earmark-medical me-1"></i>60% Certificado Médico
                                </span>
                            <% } %>
                        </td>
                        <td class="small">
                            <% if (rec.motivo) { %>
                                <span class="text-dark"><%= rec.motivo %></span>
                            <% } else { %>
                                <span class="text-muted fst-italic">Sin observaciones</span>
                            <% } %>
                        </td>

                        <% if (current_user && current_user.rol === 'inspe') { %>
                        <!-- Columna exclusiva de Inspectoría: Acreditación Médica -->
                        <td class="text-end nowrap">
                            <% if (esInjust) { %>
                            <button type="button" class="btn btn-success btn-sm py-1 px-3 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalJustificar<%= rec.id %>">
                                <i class="bi bi-file-earmark-medical me-1"></i>Acreditar Certificado Médico
                            </button>
                            <% } else if (esSalida) { %>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle py-1 px-2">
                                <i class="bi bi-bus-front me-1"></i>Salida Oficial (60%)
                            </span>
                            <% } else { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Certificado Acreditado (60%)
                            </span>
                            <% } %>
                        </td>
                        <% } else { %>
                        <!-- Columna de Estado para Profesores / Alumnos / UTP -->
                        <td class="nowrap">
                            <% if (rec.estado === 'pendiente') { %>
                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pendiente</span>
                            <% } else if (rec.estado === 'completada') { %>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Rendida</span>
                            <% } else if (rec.estado === 'no_presento') { %>
                            <span class="badge bg-danger"><i class="bi bi-x-octagon me-1"></i>No se presentó (Nota 1.1)</span>
                            <% } else { %>
                            <span class="badge bg-secondary">Cancelada</span>
                            <% } %>
                        </td>

                        <% if (current_user && current_user.rol === 'profe') { %>
                        <!-- Acciones exclusivas del Profesor de la prueba -->
                        <td class="text-end nowrap">
                            <% if (rec.estado === 'pendiente') { %>
                            <div class="btn-group btn-group-sm">
                                <form method="POST" action="/recuperaciones/<%= rec.id %>/completar" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success" title="Marcar como rendida en sala"><i class="bi bi-check-lg me-1"></i>Rendida</button>
                                </form>
                                <form method="POST" action="/recuperaciones/<%= rec.id %>/no-presento" class="d-inline" onsubmit="return confirm('¿Confirmas que el estudiante no se presentó a rendir la recuperación? Se aplicará nota 1.1 reglamentaria.')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="No se presentó (Nota 1.1)"><i class="bi bi-x-circle me-1"></i>Nota 1.1</button>
                                </form>
                                <form method="POST" action="/recuperaciones/<%= rec.id %>/cancelar" class="d-inline" onsubmit="return confirm('¿Deseas cancelar esta citación de recuperación?')">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Anular citación"><i class="bi bi-x-lg"></i></button>
                                </form>
                            </div>
                            <% } else { %>
                            <span class="text-muted small">&mdash;</span>
                            <% } %>
                        </td>
                        <% } %>
                        <% } %>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Vista móvil / Responsive cards -->
        <div class="d-md-none p-3">
            <div class="row g-3">
                <% recuperaciones.forEach(rec => { %>
                <% 
                    const exigenciaNum = Number(rec.porcentaje_exigencia);
                    const esInjustMob = (rec.tipo_justificacion === 'injustificada') || (exigenciaNum >= 70);
                    const esSalidaMob = (rec.tipo_justificacion === 'salida_pedagogica') || (rec.motivo && rec.motivo.toLowerCase().includes('salida'));
                    const profNombre = (rec.evaluacion && rec.evaluacion.profesor) ? rec.evaluacion.profesor.nombre_completo : 'Docente';
                %>
                <div class="col-12">
                    <div class="card border rounded p-3 shadow-xs">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <a href="/alumnos/<%= rec.alumno_id %>" class="text-decoration-none fw-bold text-dark">
                                    <%= rec.alumno ? (rec.alumno.nombre_completo || rec.alumno.nombre) : 'Estudiante' %>
                                </a>
                                <div class="text-muted small">
                                    <%= (rec.alumno && rec.alumno.curso) ? rec.alumno.curso.nombre : '' %>
                                </div>
                            </div>
                            <% if (current_user && current_user.rol === 'inspe') { %>
                                <% if (esInjustMob) { %>
                                <span class="badge bg-danger">70% Sin Justificar</span>
                                <% } else { %>
                                <span class="badge bg-success">60% Acreditado</span>
                                <% } %>
                            <% } else { %>
                                <% if (rec.estado === 'pendiente') { %>
                                <span class="badge bg-warning text-dark">Pendiente</span>
                                <% } else if (rec.estado === 'completada') { %>
                                <span class="badge bg-success">Rendida</span>
                                <% } else if (rec.estado === 'no_presento') { %>
                                <span class="badge bg-danger">Nota 1.1</span>
                                <% } else { %>
                                <span class="badge bg-secondary">Cancelada</span>
                                <% } %>
                            <% } %>
                        </div>

                        <div class="small mb-1">
                            <span class="text-muted">Evaluación:</span>
                            <a href="/evaluaciones/<%= rec.evaluacion_id %>" class="text-decoration-none fw-semibold">
                                <%= rec.evaluacion ? rec.evaluacion.titulo : 'Evaluación' %>
                            </a>
                            <div class="text-muted small"><i class="bi bi-person me-1"></i>Docente: <%= profNombre %></div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center small my-2">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-calendar-check me-1 text-primary"></i>Citación: <%= rec.fecha_recuperacion %>
                            </span>
                            <% if (esInjustMob) { %>
                                <span class="badge bg-danger">70% Exigencia</span>
                            <% } else if (esSalidaMob) { %>
                                <span class="badge bg-info text-dark">60% Salida Oficial</span>
                            <% } else { %>
                                <span class="badge bg-success">60% Certificado Médico</span>
                            <% } %>
                        </div>

                        <% if (rec.motivo) { %>
                        <div class="small text-muted fst-italic mb-2">
                            <%= rec.motivo %>
                        </div>
                        <% } %>

                        <% if (current_user && current_user.rol === 'inspe') { %>
                        <!-- Acción móvil para Inspectoría -->
                        <div class="mt-2 pt-2 border-top">
                            <% if (esInjustMob) { %>
                            <button type="button" class="btn btn-success btn-sm w-100 py-2 shadow-xs fw-semibold" data-bs-toggle="modal" data-bs-target="#modalJustificar<%= rec.id %>">
                                <i class="bi bi-file-earmark-medical me-1"></i>Acreditar Certificado Médico (60%)
                            </button>
                            <% } else { %>
                            <div class="text-center py-1">
                                <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-3">
                                    <i class="bi bi-check-circle-fill me-1"></i>Certificado Acreditado en Inspectoría
                                </span>
                            </div>
                            <% } %>
                        </div>
                        <% } else if (current_user && current_user.rol === 'profe' && rec.estado === 'pendiente') { %>
                        <!-- Acciones móviles para Profesor -->
                        <div class="d-flex flex-wrap gap-2 mt-2 pt-2 border-top">
                            <form method="POST" action="/recuperaciones/<%= rec.id %>/completar" class="flex-grow-1">
                                <button type="submit" class="btn btn-sm btn-success w-100"><i class="bi bi-check-lg me-1"></i>Rendida</button>
                            </form>
                            <form method="POST" action="/recuperaciones/<%= rec.id %>/no-presento" class="flex-grow-1" onsubmit="return confirm('¿Confirmas que el alumno no se presentó? Se aplicará nota 1.1 reglamentaria.')">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-x-circle me-1"></i>Nota 1.1</button>
                            </form>
                            <form method="POST" action="/recuperaciones/<%= rec.id %>/cancelar" onsubmit="return confirm('¿Cancelar esta citación?')">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancelar"><i class="bi bi-x-lg"></i></button>
                            </form>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <% } else { %>
        <!-- Estado Vacío -->
        <div class="card-body text-center py-5">
            <i class="bi bi-check2-circle display-4 text-success mb-3 d-block"></i>
            <h5 class="fw-bold">No hay citaciones de recuperación en este listado</h5>
            <p class="text-muted small mb-3">No se registran alumnos en esta categoría de filtro.</p>
            <% if (current_user && current_user.rol === 'profe') { %>
            <a href="/recuperaciones/crear" class="btn btn-warning">
                <i class="bi bi-plus-circle me-1"></i>Programar nueva citación
            </a>
            <% } else { %>
            <a href="/recuperaciones" class="btn btn-outline-primary btn-sm">Ver todas las citaciones</a>
            <% } %>
        </div>
        <% } %>
    </div>
</div>

<!-- Modales de Justificación Médica exclusivos para Inspectoría General -->
<% if (current_user && current_user.rol === 'inspe') { %>
    <% recuperaciones.forEach(rec => { %>
        <% if (Number(rec.porcentaje_exigencia) >= 70) { %>
        <div class="modal fade" id="modalJustificar<%= rec.id %>" tabindex="-1" aria-labelledby="modalJustLabel<%= rec.id %>" aria-hidden="true" data-bs-backdrop="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <form method="POST" action="/recuperaciones/<%= rec.id %>/justificar-medico">
                        <div class="modal-header bg-success text-white py-3">
                            <h6 class="modal-title mb-0 fw-bold" id="modalJustLabel<%= rec.id %>">
                                <i class="bi bi-file-earmark-medical me-2"></i>Acreditar Certificado Médico en Inspectoría
                            </h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i>
                                Al ingresar el documento probatorio, <strong>la exigencia del estudiante se rebajará automáticamente del 70% al 60%</strong> reglamentario.
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Estudiante Ausente:</label>
                                <div class="form-control-plaintext py-0 fw-semibold text-dark">
                                    <%= rec.alumno ? rec.alumno.nombre_completo : 'Estudiante' %> 
                                    <span class="text-muted fw-normal">(<%= rec.alumno && rec.alumno.curso ? rec.alumno.curso.nombre : '' %>)</span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Evaluación Original & Profesor:</label>
                                <div class="form-control-plaintext py-0 text-muted">
                                    <%= rec.evaluacion ? rec.evaluacion.titulo : 'Evaluación' %> 
                                    (<%= (rec.evaluacion && rec.evaluacion.profesor) ? rec.evaluacion.profesor.nombre_completo : 'Docente' %>)
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Número de Folio / N° Licencia Médica <span class="text-danger">*</span></label>
                                <input type="text" name="folio" class="form-control form-control-sm" required placeholder="Ej: MED-2026-9812 o Folio N° 44102">
                                <div class="form-text">Identificador del certificado médico recepcionado en Inspectoría.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Diagnóstico / Centro de Salud / Observaciones de Inspectoría</label>
                                <textarea name="diagnostico" class="form-control form-control-sm" rows="2" placeholder="Ej: Reposo médico 48 hrs otorgado por Dr. Morales (CESFAM Central)..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer py-2 bg-light">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success btn-sm px-3 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i>Acreditar Certificado (Rebajar a 60%)
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <% } %>
    <% }) %>
<% } %>

<%- include('../partials/footer') %>
