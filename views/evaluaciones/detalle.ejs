<%- include('../partials/header', { 
    title: ev.titulo, 
    active: 'evaluaciones',
    breadcrumb: `<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item"><a href="/evaluaciones">Evaluaciones</a></li><li class="breadcrumb-item active text-truncate" style="max-width: 250px;">${ev.titulo}</li></ol></nav>`
}) %>

<%
    const hoy = new Date().toISOString().split('T')[0];
    
    // Contadores de asistencia
    let ausentesCount = 0;
    let presentesCount = 0;
    let justificadosCount = 0;
    
    alumnos.forEach(a => {
        const as = asistencias[a.id];
        if (as) {
            if (as.estado_asistencia === 'justificado' || as.estado_asistencia === 'salida' || as.justificado) {
                justificadosCount++;
                ausentesCount++;
            } else if (as.estado_asistencia === 'injustificada' || !as.presente) {
                ausentesCount++;
            } else {
                presentesCount++;
            }
        } else {
            if (ev.asistencia_guardada) {
                presentesCount++;
            }
        }
    });

    // Para Inspectoría: lista de estudiantes ausentes
    const alumnosAfectados = alumnos.filter(a => {
        const as = asistencias[a.id];
        if (!as) return false;
        if (as.estado_asistencia) return as.estado_asistencia !== 'presente';
        return !as.presente;
    });

    const esProfeTitular = (current_user.rol === 'profe' && String(current_user.profesor_id) === String(ev.profesor_id));
    const esProfeObservador = (current_user.rol === 'profe' && String(current_user.profesor_id) !== String(ev.profesor_id));
%>

<!-- Encabezado de la Evaluación -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-dark"><%= ev.titulo %></h4>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge" style="background:<%= (ev.asignatura && ev.asignatura.color) ? ev.asignatura.color : '#14213D' %>; font-size: 0.8rem;">
                <%= ev.asignatura ? ev.asignatura.nombre : 'Asignatura' %>
            </span>
            <span class="badge bg-light text-dark border">
                <i class="bi bi-mortarboard me-1 text-primary"></i><%= ev.curso ? ev.curso.nombre : 'Curso' %> (<%= ev.curso ? ev.curso.nivel : '' %>)
            </span>
            <span class="badge bg-light text-dark border">
                <i class="bi bi-calendar-event me-1 text-primary"></i><%= ev.fecha %>
            </span>
            <% if (ev.hora) { %>
            <span class="badge bg-light text-dark border">
                <i class="bi bi-clock me-1 text-secondary"></i><%= ev.hora %>
            </span>
            <% } %>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <% if (esProfeTitular) { %>
        <a href="/evaluaciones/<%= ev.id %>/editar" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <form method="POST" action="/evaluaciones/<%= ev.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar esta evaluación?')">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Eliminar
            </button>
        </form>
        <% } %>
        <a href="/evaluaciones" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<!-- Banner Contextual según Rol -->
<% if (current_user.rol === 'inspe') { %>
<div class="card border-warning border-opacity-50 shadow-xs mb-4" style="background: linear-gradient(135deg, rgba(255, 193, 7, 0.08) 0%, rgba(255, 255, 255, 0.95) 100%);">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-start gap-3">
                <div class="p-2 bg-warning bg-opacity-25 rounded-circle text-warning-emphasis fs-4 flex-shrink-0">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h6 class="fw-bold mb-0 text-dark">Panel de Inspectoría General &mdash; Acreditación de Justificaciones</h6>
                        <span class="badge bg-warning text-dark"><i class="bi bi-shield-check me-1"></i>Inspectoría</span>
                    </div>
                    <p class="small text-muted mb-0">
                        Atribución de Inspectoría: Registra y valida licencias médicas o salidas pedagógicas para rebajar la exigencia de las pruebas recuperativas (<strong>70% sin justificar &rarr; 60% regular</strong>).
                    </p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center flex-shrink-0">
                <span class="badge bg-white text-dark border py-2 px-3 shadow-xs">
                    <i class="bi bi-people me-1 text-primary"></i><strong><%= alumnos.length %></strong> Alumnos Curso
                </span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-2 px-3 shadow-xs">
                    <i class="bi bi-x-circle me-1"></i><strong><%= alumnosAfectados.length %></strong> Ausente(s)
                </span>
                <% if (ev.asistencia_guardada) { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-3 shadow-xs">
                    <i class="bi bi-check-circle-fill me-1"></i>Lista Cerrada
                </span>
                <% } else { %>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-2 px-3 shadow-xs">
                    <i class="bi bi-clock me-1"></i>Pase Pendiente por Docente
                </span>
                <% } %>
            </div>
        </div>
    </div>
</div>
<% } else if (esProfeObservador) { %>
<div class="alert alert-secondary bg-light border d-flex flex-wrap align-items-center justify-content-between p-3 mb-4 gap-2 shadow-xs">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-eye text-primary fs-3 me-1"></i>
        <div>
            <strong class="d-block text-dark">Modo Solo Consulta: Asignatura de <%= ev.profesor ? ev.profesor.nombre_completo : 'otro docente' %></strong>
            <span class="small text-muted">
                Esta evaluación corresponde a la asignatura de <strong><%= ev.profesor ? ev.profesor.nombre_completo : 'otro docente' %></strong> en el curso <strong><%= ev.curso ? ev.curso.nombre : '' %></strong>. Puedes consultar la nómina y calendarización para coordinar fechas y cupos, pero el pase de lista y registro de asistencia corresponde únicamente al docente titular asignado.
            </span>
        </div>
    </div>
    <span class="badge bg-secondary px-3 py-2"><i class="bi bi-lock me-1"></i>Solo Consulta</span>
</div>
<% } %>

<!-- Contenido Principal: Ficha Técnica (4 cols) y Panel de Asistencia (8 cols) -->
<div class="row g-4 align-items-start">
    <!-- Columna Izquierda: Ficha de la Evaluación -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Ficha de la Evaluación</h6>
                <% if (ev.asistencia_guardada) { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-lock-fill me-1"></i>Cerrada</span>
                <% } else { %>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-clock me-1"></i>Abierta</span>
                <% } %>
            </div>
            <div class="card-body p-3 p-md-4">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted py-2" style="width:40%;">Fecha</td>
                        <td class="fw-semibold py-2"><i class="bi bi-calendar-event me-1 text-primary"></i><%= ev.fecha %></td>
                    </tr>
                    <tr>
                        <td class="text-muted py-2">Hora</td>
                        <td class="py-2"><%= ev.hora || 'Horario regular de clases' %></td>
                    </tr>
                    <tr>
                        <td class="text-muted py-2">Asignatura</td>
                        <td class="py-2"><span class="badge" style="background:<%= (ev.asignatura && ev.asignatura.color) ? ev.asignatura.color : '#14213D' %>;"><%= ev.asignatura ? ev.asignatura.nombre : 'General' %></span></td>
                    </tr>
                    <tr>
                        <td class="text-muted py-2">Curso</td>
                        <td class="py-2"><strong><%= ev.curso ? ev.curso.nombre : 'Curso' %></strong> (<%= ev.curso ? ev.curso.nivel : '' %>)</td>
                    </tr>
                    <tr>
                        <td class="text-muted py-2">Docente</td>
                        <td class="py-2"><%= ev.profesor ? ev.profesor.nombre_completo : 'Docente' %></td>
                    </tr>
                    <tr>
                        <td class="text-muted py-2">Estado Lista</td>
                        <td class="py-2">
                            <% if (ev.asistencia_guardada) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-check-circle-fill me-1"></i>Pase de lista guardado
                            </span>
                            <% } else { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                <i class="bi bi-clock me-1"></i>Pendiente por docente
                            </span>
                            <% } %>
                        </td>
                    </tr>
                </table>

                <!-- Resumen de Asistencia -->
                <div class="bg-light p-3 rounded border my-3">
                    <div class="small fw-bold text-uppercase text-muted mb-2">Resumen de Asistencia del Curso:</div>
                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                        <span><i class="bi bi-check2 text-success me-1"></i>Presentes:</span>
                        <strong class="text-success"><%= presentesCount %> estudiantes</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small">
                        <span><i class="bi bi-x-circle text-danger me-1"></i>Inasistencias registradas:</span>
                        <strong class="text-danger"><%= ausentesCount %> estudiantes</strong>
                    </div>
                </div>

                <% if (ev.descripcion) { %>
                <hr class="my-3">
                <h6 class="fw-bold small text-muted text-uppercase mb-2">Contenidos / Temario</h6>
                <p class="text-muted small mb-0"><%= ev.descripcion %></p>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Panel de Asistencia / Justificaciones -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-people me-2 text-primary"></i>
                    <% if (current_user.rol === 'inspe') { %>
                        Gestión de Inasistencias de la Evaluación
                    <% } else if (esProfeObservador) { %>
                        Nómina de Estudiantes Convocados (<%= alumnos.length %>)
                    <% } else { %>
                        Control de Asistencia (<%= alumnos.length %> alumnos)
                    <% } %>
                </h6>

                <div class="d-flex align-items-center gap-2">
                    <% if (ev.asistencia_guardada) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-lock-fill me-1"></i>Asistencia Guardada
                    </span>
                    <% } %>
                    <% if (current_user.rol === 'inspe') { %>
                    <span class="badge bg-warning text-dark"><i class="bi bi-shield-check me-1"></i>Inspectoría General</span>
                    <% } else if (esProfeTitular) { %>
                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-person-video3 me-1"></i>Docente Titular</span>
                    <% } %>
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <% if (alumnos.length === 0) { %>
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-people display-4 d-block mb-2"></i>
                    <p class="mb-0">No hay alumnos registrados en este curso.</p>
                </div>
                <% } else if (current_user.rol === 'inspe') { %>
                    <!-- ============================================================== -->
                    <!-- VISTA DE ACREDITACIÓN DE JUSTIFICATIVOS (INSPECTORÍA GENERAL) -->
                    <!-- ============================================================== -->
                    <div class="alert alert-light border border-warning-subtle small mb-3 py-2">
                        <i class="bi bi-shield-check text-warning me-1"></i>
                        <strong>Atribución de Inspectoría:</strong> El pase de lista lo realiza el profesor en sala. Aquí Inspectoría acredita licencias médicas o salidas pedagógicas para los estudiantes que faltaron, rebajando su exigencia en la prueba recuperativa del <strong>70% al 60%</strong>.
                    </div>

                    <% if (!ev.asistencia_guardada) { %>
                    <div class="text-center py-5 bg-light rounded border border-dashed my-3">
                        <i class="bi bi-clock-history text-warning fs-1 d-block mb-2"></i>
                        <h6 class="fw-bold mb-1">Pase de lista pendiente por el docente</h6>
                        <p class="text-muted small mb-0 px-3" style="max-width: 520px; margin: 0 auto;">
                            El profesor titular (<strong><%= ev.profesor ? ev.profesor.nombre_completo : 'Docente' %></strong>) aún no ha guardado la lista de asistencia en sala. Una vez que el docente registre la asistencia, los estudiantes ausentes aparecerán aquí para acreditar sus justificativos médicos.
                        </p>
                    </div>

                    <h6 class="fw-bold small text-muted text-uppercase mt-4 mb-2">Nómina del curso (<%= alumnos.length %> alumnos convocados)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Estudiante</th>
                                    <th>RUT</th>
                                    <th>Estado Asistencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% alumnos.forEach((alumno, idx) => { %>
                                <tr>
                                    <td class="text-muted small"><%= idx + 1 %></td>
                                    <td><strong><%= alumno.nombre_completo %></strong></td>
                                    <td class="text-muted small font-monospace"><%= alumno.rut %></td>
                                    <td><span class="badge bg-light text-muted border"><i class="bi bi-clock me-1"></i>Pendiente por docente</span></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% } else if (alumnosAfectados.length === 0) { %>
                    <div class="text-center py-5 bg-light rounded border border-dashed my-3">
                        <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                        <h6 class="fw-bold mb-1 text-success">¡Asistencia Completa en Sala!</h6>
                        <p class="text-muted small mb-0 px-3" style="max-width: 520px; margin: 0 auto;">
                            Todos los estudiantes convocados del curso (<%= alumnos.length %> alumnos) asistieron a la evaluación. No hay ausencias que requieran justificación médica en Inspectoría.
                        </p>
                    </div>

                    <% } else { %>
                    <!-- Formulario de Acreditación de Justificaciones Médicas para Alumnos Ausentes -->
                    <form method="POST" action="/evaluaciones/<%= ev.id %>/asistencia">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 28%;">Estudiante Ausente</th>
                                        <th style="width: 34%;">Condición de Inasistencia</th>
                                        <th style="width: 26%;">Folio / Certificado Médico</th>
                                        <th class="text-center" style="width: 12%;">Exigencia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% alumnosAfectados.forEach(alumno => { %>
                                    <% 
                                        const asist = asistencias[alumno.id]; 
                                        let estadoActual = 'injustificada';
                                        if (asist) {
                                            let st = asist.estado_asistencia;
                                            if (Array.isArray(st)) st = st[0];
                                            if (st) estadoActual = st;
                                            else if (asist.justificado) estadoActual = 'justificado';
                                            else estadoActual = 'injustificada';
                                        }
                                        let mot = asist ? asist.motivo : '';
                                        if (Array.isArray(mot)) mot = mot[0];
                                    %>
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark"><%= alumno.nombre_completo %></div>
                                            <div class="text-muted small font-monospace"><%= alumno.rut %></div>
                                        </td>
                                        <td>
                                            <select name="estado_<%= alumno.id %>" class="form-select form-select-sm select-estado" data-alumno-id="<%= alumno.id %>">
                                                <option value="injustificada" <%= estadoActual === 'injustificada' ? 'selected' : '' %>>❌ Inasistencia Injustificada (70%)</option>
                                                <option value="justificado" <%= (estadoActual === 'justificado' || estadoActual === 'licencia') ? 'selected' : '' %>>🏥 Justificado con Certificado Médico (60%)</option>
                                                <option value="salida" <%= estadoActual === 'salida' ? 'selected' : '' %>>🚌 Salida Pedagógica Oficial (60%)</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" name="motivo_<%= alumno.id %>" class="form-control form-control-sm"
                                                   placeholder="N° Folio o documento médico..."
                                                   value="<%= mot || '' %>"
                                                   id="motivo_<%= alumno.id %>">
                                        </td>
                                        <td class="text-center" id="badge_exigencia_<%= alumno.id %>">
                                            <% if (estadoActual === 'injustificada') { %>
                                            <span class="badge bg-danger" title="70% de exigencia">70%</span>
                                            <% } else { %>
                                            <span class="badge bg-success" title="60% regular">60%</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top gap-2">
                            <small class="text-muted"><i class="bi bi-shield-check me-1"></i>Al guardar, las pruebas recuperativas se actualizan automáticamente al 60% o 70%.</small>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold shadow-xs">
                                <i class="bi bi-check-lg me-1"></i>Guardar Justificaciones
                            </button>
                        </div>
                    </form>
                    <% } %>
<% } else if (esProfeObservador) { %>
                    <!-- ============================================================== -->
                    <!-- VISTA PARA PROFESOR OBSERVADOR (No es titular de esta prueba)   -->
                    <!-- ============================================================== -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Alumno</th>
                                    <th>RUT</th>
                                    <th>Condición de Asistencia</th>
                                    <th>Observación</th>
                                    <th class="text-center">Exigencia Recup.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% alumnos.forEach((alumno, idx) => { %>
                                <% 
                                    const asist = asistencias[alumno.id]; 
                                    let estadoActual = 'pendiente_docente';
                                    if (ev.asistencia_guardada) {
                                        if (asist) {
                                            if (asist.estado_asistencia) estadoActual = asist.estado_asistencia;
                                            else if (asist.justificado) estadoActual = 'justificado';
                                            else if (!asist.presente) estadoActual = 'injustificada';
                                            else estadoActual = 'presente';
                                        } else {
                                            estadoActual = 'presente';
                                        }
                                    }
                                %>
                                <tr>
                                    <td class="text-muted small"><%= idx + 1 %></td>
                                    <td>
                                        <div class="fw-semibold"><%= alumno.nombre_completo %></div>
                                    </td>
                                    <td class="text-muted small font-monospace"><%= alumno.rut %></td>
                                    <td>
                                        <% if (!ev.asistencia_guardada) { %>
                                        <span class="badge bg-light text-muted border">
                                            <i class="bi bi-clock me-1"></i>Pendiente por <%= ev.profesor ? ev.profesor.nombre_completo : 'docente titular' %>
                                        </span>
                                        <% } else if (estadoActual === 'presente') { %>
                                        <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Presente</span>
                                        <% } else if (estadoActual === 'injustificada') { %>
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inasistencia</span>
                                        <% } else if (estadoActual === 'salida') { %>
                                        <span class="badge bg-info text-dark"><i class="bi bi-bus-front me-1"></i>Salida Pedagógica</span>
                                        <% } else { %>
                                        <span class="badge bg-success"><i class="bi bi-file-earmark-medical me-1"></i>Justificado</span>
                                        <% } %>
                                    </td>
                                    <td class="text-muted small"><%= (asist && asist.motivo) ? asist.motivo : '-' %></td>
                                    <td class="text-center">
                                        <% if (!ev.asistencia_guardada || estadoActual === 'presente') { %>
                                        <span class="text-muted small">&mdash;</span>
                                        <% } else if (estadoActual === 'injustificada') { %>
                                        <span class="badge bg-danger">70%</span>
                                        <% } else { %>
                                        <span class="badge bg-success">60%</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } else if (esProfeTitular) { %>
                    <!-- ========================================== -->
                    <!-- VISTA PARA PROFESOR TITULAR DE LA PRUEBA   -->
                    <!-- ========================================== -->
                    <% if (ev.fecha > hoy) { %>
                    <div class="alert alert-primary bg-primary bg-opacity-10 border-primary border-opacity-25 py-3 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary fs-6"><i class="bi bi-calendar-check me-1"></i>Evaluación Calendarizada</span>
                            <strong class="text-primary">Programada para el <%= ev.fecha %> <%= ev.hora ? 'a las ' + ev.hora : '' %></strong>
                        </div>
                        <p class="small text-muted mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Esta evaluación se encuentra planificada para una fecha futura. El botón y registro para <strong>Guardar Asistencia</strong> se habilitarán automáticamente el día de la rendición.
                        </p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Alumno</th>
                                    <th>RUT</th>
                                    <th class="text-center">Condición Actual</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% alumnos.forEach((alumno, idx) => { %>
                                <tr>
                                    <td class="text-muted small"><%= idx + 1 %></td>
                                    <td>
                                        <div class="fw-semibold"><%= alumno.nombre_completo %></div>
                                    </td>
                                    <td class="text-muted small font-monospace"><%= alumno.rut %></td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            <i class="bi bi-hourglass me-1"></i>Convocado
                                        </span>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% } else if (ev.asistencia_guardada) { %>
                    <div class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 py-2 px-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <i class="bi bi-lock-fill text-success me-1"></i>
                            <strong>Asistencia Guardada:</strong> El pase de lista para esta prueba ya fue completado y cerrado.
                        </div>
                        <span class="badge bg-success">Lista Cerrada</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Alumno</th>
                                    <th>RUT</th>
                                    <th>Estado Asistencia</th>
                                    <th>Observación</th>
                                    <th class="text-center">Exigencia Recup.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% alumnos.forEach(alumno => { %>
                                <% 
                                    const asist = asistencias[alumno.id]; 
                                    let estadoActual = 'presente';
                                    if (asist) {
                                        if (asist.estado_asistencia) estadoActual = asist.estado_asistencia;
                                        else if (asist.justificado) estadoActual = 'justificado';
                                        else if (!asist.presente) estadoActual = 'injustificada';
                                    }
                                %>
                                <tr>
                                    <td>
                                        <div class="fw-semibold"><%= alumno.nombre_completo %></div>
                                    </td>
                                    <td class="text-muted small font-monospace"><%= alumno.rut %></td>
                                    <td>
                                        <% if (estadoActual === 'presente') { %>
                                        <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Presente</span>
                                        <% } else if (estadoActual === 'injustificada') { %>
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inasistencia</span>
                                        <% } else if (estadoActual === 'salida') { %>
                                        <span class="badge bg-info text-dark"><i class="bi bi-bus-front me-1"></i>Salida Pedagógica</span>
                                        <% } else { %>
                                        <span class="badge bg-success"><i class="bi bi-file-earmark-medical me-1"></i>Justificado</span>
                                        <% } %>
                                    </td>
                                    <td class="text-muted small"><%= (asist && asist.motivo) ? asist.motivo : '-' %></td>
                                    <td class="text-center">
                                        <% if (estadoActual === 'presente') { %>
                                        <span class="text-muted small">&mdash;</span>
                                        <% } else if (estadoActual === 'injustificada') { %>
                                        <span class="badge bg-danger" title="70% de exigencia">70%</span>
                                        <% } else { %>
                                        <span class="badge bg-success" title="60% regular">60%</span>
                                        <% } %>

                                        <% if (estadoActual !== 'presente') { %>
                                        <div class="mt-1">
                                            <a href="/recuperaciones/crear?evaluacion_id=<%= ev.id %>&alumno_id=<%= alumno.id %>" class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size: 0.72rem;">
                                                <i class="bi bi-calendar-plus me-1"></i>Programar Recup.
                                            </a>
                                        </div>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% } else { %>
                    <!-- Formulario de pase de lista del profesor -->
                    <div class="alert alert-light border border-info-subtle small mb-3 py-2">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        <strong>Pase de lista del profesor:</strong> Marca <em>Asistente</em>, <em>No Asiste</em> o <em>Salida Pedagógica</em>. Una vez guardada, la asistencia quedará fijada.
                    </div>

                    <form method="POST" action="/evaluaciones/<%= ev.id %>/asistencia">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 30%;">Alumno</th>
                                        <th style="width: 30%;">Estado de Asistencia</th>
                                        <th style="width: 25%;">Observación</th>
                                        <th class="text-center" style="width: 15%;">Exigencia Recup.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% alumnos.forEach(alumno => { %>
                                    <% 
                                        const asist = asistencias[alumno.id]; 
                                        let estadoActual = 'presente';
                                        if (asist) {
                                            if (asist.estado_asistencia) estadoActual = asist.estado_asistencia;
                                            else if (asist.justificado) estadoActual = 'justificado';
                                            else if (!asist.presente) estadoActual = 'injustificada';
                                        }
                                    %>
                                    <tr>
                                        <td>
                                            <div class="fw-semibold"><%= alumno.nombre_completo %></div>
                                            <div class="text-muted small font-monospace"><%= alumno.rut %></div>
                                        </td>
                                        <td>
                                            <% if (estadoActual === 'justificado') { %>
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="badge bg-success py-2 px-2"><i class="bi bi-file-earmark-medical me-1"></i>Justificado (Inspectoría)</span>
                                                <input type="hidden" name="estado_<%= alumno.id %>" value="justificado">
                                            </div>
                                            <% } else { %>
                                            <select name="estado_<%= alumno.id %>" class="form-select form-select-sm select-estado" data-alumno-id="<%= alumno.id %>">
                                                <option value="presente" <%= estadoActual === 'presente' ? 'selected' : '' %>>✅ Asistente</option>
                                                <option value="injustificada" <%= estadoActual === 'injustificada' ? 'selected' : '' %>>❌ No Asiste</option>
                                                <option value="salida" <%= estadoActual === 'salida' ? 'selected' : '' %>>🚌 Salida Pedagógica</option>
                                            </select>
                                            <% } %>
                                        </td>
                                        <td>
                                            <input type="text" name="motivo_<%= alumno.id %>" class="form-control form-control-sm"
                                                   placeholder="Observación..."
                                                   value="<%= (asist && asist.motivo) ? asist.motivo : '' %>"
                                                   id="motivo_<%= alumno.id %>"
                                                   <%= estadoActual === 'presente' ? 'disabled' : '' %>>
                                        </td>
                                        <td class="text-center" id="badge_exigencia_<%= alumno.id %>">
                                            <% if (estadoActual === 'presente') { %>
                                            <span class="text-muted small">&mdash;</span>
                                            <% } else if (estadoActual === 'injustificada') { %>
                                            <span class="badge bg-danger" title="70% de exigencia">70%</span>
                                            <% } else if (estadoActual === 'salida') { %>
                                            <span class="badge bg-info text-dark" title="60% regular">60%</span>
                                            <% } else { %>
                                            <span class="badge bg-success" title="60% regular">60%</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-2 border-top gap-2">
                            <small class="text-muted"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Una vez guardada, la lista de asistencia se cierra.</small>
                            <button type="submit" class="btn btn-primary px-4" onclick="return confirm('¿Confirmas guardar la asistencia? Una vez guardada, no podrás modificarla posteriormente.')">
                                <i class="bi bi-check-lg me-1"></i>Guardar Asistencia
                            </button>
                        </div>
                    </form>
                    <% } %>

                <% } else { %>
                    <!-- ============================================== -->
                    <!-- VISTA SOLO LECTURA (UTP, Alumnos, Apoderados)  -->
                    <!-- ============================================== -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Alumno</th>
                                    <th>RUT</th>
                                    <th>Estado</th>
                                    <th>Observación</th>
                                    <th class="text-center">Exigencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% alumnos.forEach(alumno => { %>
                                <% 
                                    const asist = asistencias[alumno.id];
                                    let est = 'presente';
                                    if (asist) {
                                        if (asist.estado_asistencia) est = asist.estado_asistencia;
                                        else if (asist.justificado) est = 'justificado';
                                        else if (!asist.presente) est = 'injustificada';
                                    } else if (!ev.asistencia_guardada) {
                                        est = 'pendiente';
                                    }
                                %>
                                <tr>
                                    <td><strong><%= alumno.nombre_completo %></strong></td>
                                    <td class="text-muted small font-monospace"><%= alumno.rut %></td>
                                    <td>
                                        <% if (est === 'pendiente') { %>
                                        <span class="badge bg-light text-muted border">Pendiente</span>
                                        <% } else if (est === 'presente') { %>
                                        <span class="badge bg-success">Presente</span>
                                        <% } else if (est === 'injustificada') { %>
                                        <span class="badge bg-danger">Inasistencia Sin Justificar</span>
                                        <% } else if (est === 'salida') { %>
                                        <span class="badge bg-info text-dark">Salida Pedagógica</span>
                                        <% } else { %>
                                        <span class="badge bg-success">Justificado</span>
                                        <% } %>
                                    </td>
                                    <td class="text-muted small"><%= (asist && asist.motivo) ? asist.motivo : '-' %></td>
                                    <td class="text-center">
                                        <% if (est === 'injustificada') { %>
                                        <span class="badge bg-danger">70%</span>
                                        <% } else if (est === 'justificado' || est === 'salida') { %>
                                        <span class="badge bg-success">60%</span>
                                        <% } else { %>
                                        <span class="text-muted small">&mdash;</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer', {
    scripts: `
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.select-estado').forEach(sel => {
        sel.addEventListener('change', function() {
            const alumnoId = this.getAttribute('data-alumno-id');
            const motivoInput = document.getElementById('motivo_' + alumnoId);
            const badgeContainer = document.getElementById('badge_exigencia_' + alumnoId);
            const badgeMobContainer = document.getElementById('badge_exigencia_mob_' + alumnoId);
            const val = this.value;

            if (val === 'presente') {
                if (motivoInput) {
                    motivoInput.disabled = true;
                    motivoInput.value = '';
                }
                if (badgeContainer) badgeContainer.innerHTML = '<span class="text-muted small">&mdash;</span>';
                if (badgeMobContainer) badgeMobContainer.innerHTML = '<span class="badge bg-secondary">Presente</span>';
            } else {
                if (motivoInput) {
                    motivoInput.disabled = false;
                }
                if (badgeContainer) {
                    if (val === 'injustificada') {
                        badgeContainer.innerHTML = '<span class="badge bg-danger" title="70% de exigencia">70%</span>';
                    } else if (val === 'salida') {
                        badgeContainer.innerHTML = '<span class="badge bg-info text-dark" title="60% regular">60%</span>';
                    } else {
                        badgeContainer.innerHTML = '<span class="badge bg-success" title="60% regular">60%</span>';
                    }
                }
                if (badgeMobContainer) {
                    if (val === 'injustificada') {
                        badgeMobContainer.innerHTML = '<span class="badge bg-danger">Exigencia 70%</span>';
                    } else {
                        badgeMobContainer.innerHTML = '<span class="badge bg-success">Exigencia 60%</span>';
                    }
                }
            }
        });
    });
});
</script>
`
}) %>
