<%- include('../partials/header', { 
    title: 'Evaluaciones', 
    active: 'evaluaciones',
    breadcrumb: '<nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/">Inicio</a></li><li class="breadcrumb-item active">Evaluaciones</li></ol></nav>'
}) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="mb-0">
            <i class="bi bi-clipboard-check me-2 text-primary"></i>
            <%= current_user.rol === 'inspe' ? 'Evaluaciones con Inasistencias' : 'Evaluaciones' %>
        </h4>
        <% if (current_user.rol === 'inspe') { %>
        <small class="text-muted">Mostrando únicamente las evaluaciones con estudiantes en condición de inasistencia</small>
        <% } %>
    </div>
    <% if (current_user.rol === 'profe') { %>
    <a href="/evaluaciones/crear" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nueva Evaluación
    </a>
    <% } %>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="GET" action="/evaluaciones" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Desde</label>
                <input type="date" name="fecha_desde" class="form-control form-control-sm" value="<%= filtros.fecha_desde || '' %>">
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Hasta</label>
                <input type="date" name="fecha_hasta" class="form-control form-control-sm" value="<%= filtros.fecha_hasta || '' %>">
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small mb-1">Curso</label>
                <select name="curso_id" class="form-select form-select-sm">
                    <option value="">Todos los cursos</option>
                    <% cursos.forEach(c => { %>
                    <option value="<%= c.id %>" <%= filtros.curso_id == c.id ? 'selected' : '' %>><%= c.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small mb-1">Asignatura</label>
                <select name="asignatura_id" class="form-select form-select-sm">
                    <option value="">Todas las asignaturas</option>
                    <% asignaturas.forEach(a => { %>
                    <option value="<%= a.id %>" <%= filtros.asignatura_id == a.id ? 'selected' : '' %>><%= a.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1 mt-2 mt-md-0">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-search"></i> Filtrar</button>
                <a href="/evaluaciones" class="btn btn-outline-secondary btn-sm" title="Limpiar"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla y Tarjetas -->
<div class="card">
    <div class="card-body p-0">
        <% if (evaluaciones.length > 0) { %>
        <!-- Vista tabla para PC, Laptop y Tablet -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover mb-0 align-middle" style="min-width: 680px;">
                <thead class="table-light">
                    <tr>
                        <th class="nowrap">Fecha</th>
                        <th class="nowrap">Hora</th>
                        <th style="min-width: 150px;">Evaluación</th>
                        <th class="nowrap">Asignatura</th>
                        <th class="nowrap">Curso</th>
                        <th style="min-width: 130px;">Profesor</th>
                        <th class="text-end nowrap">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% evaluaciones.forEach(ev => { %>
                    <tr>
                        <td class="nowrap">
                            <span><%= ev.fecha %></span>
                        </td>
                        <td class="nowrap"><%= ev.hora || '-' %></td>
                        <td>
                            <a href="/evaluaciones/<%= ev.id %>" class="text-decoration-none fw-semibold">
                                <%= ev.titulo %>
                            </a>
                        </td>
                        <td class="nowrap"><span class="badge" style="background:<%= ev.asignatura.color %>;"><%= ev.asignatura.nombre %></span></td>
                        <td class="nowrap"><strong><%= ev.curso.nombre %></strong></td>
                        <td><%= ev.profesor.nombre_completo %></td>
                        <td class="text-end nowrap">
                            <div class="btn-group btn-group-sm">
                                <a href="/evaluaciones/<%= ev.id %>" class="btn btn-outline-primary" title="Ver detalles y asistencia"><i class="bi bi-eye"></i></a>
                                <% if (current_user.rol === 'profe' && current_user.profesor_id == ev.profesor_id) { %>
                                <a href="/evaluaciones/<%= ev.id %>/editar" class="btn btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form method="POST" action="/evaluaciones/<%= ev.id %>/eliminar" class="d-inline" onsubmit="return confirm('¿Eliminar esta evaluación?')">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Vista tarjetas para Celulares -->
        <div class="d-md-none p-3">
            <div class="row g-3">
                <% evaluaciones.forEach(ev => { %>
                <div class="col-12">
                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="badge" style="background:<%= ev.asignatura.color %>;"><%= ev.asignatura.nombre %></span>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-calendar-event me-1"></i><%= ev.fecha %> <%= ev.hora || '' %>
                            </span>
                        </div>
                        <h6 class="mb-1">
                            <a href="/evaluaciones/<%= ev.id %>" class="text-decoration-none text-dark fw-bold">
                                <%= ev.titulo %>
                            </a>
                        </h6>
                        <div class="small text-muted mb-2">
                            <strong><%= ev.curso.nombre %></strong> &bull; Prof: <%= ev.profesor.nombre_completo %>
                        </div>
                        <div class="d-flex gap-2 pt-2 border-top">
                            <a href="/evaluaciones/<%= ev.id %>" class="btn btn-sm btn-outline-primary flex-grow-1"><i class="bi bi-eye me-1"></i>Detalles</a>
                            <% if (current_user.rol === 'profe' && current_user.profesor_id == ev.profesor_id) { %>
                            <a href="/evaluaciones/<%= ev.id %>/editar" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <form method="POST" action="/evaluaciones/<%= ev.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta evaluación?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } else { %>
        <div class="text-center py-5 text-muted">
            <i class="bi bi-clipboard-x display-1"></i>
            <p class="mt-3">No se encontraron evaluaciones con los filtros aplicados.</p>
            <% if (current_user.rol === 'profe') { %>
            <a href="/evaluaciones/crear" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Crear primera evaluación</a>
            <% } %>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
